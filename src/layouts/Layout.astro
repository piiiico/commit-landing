---
import { posts } from '../data/posts';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  publishDate?: string; // ISO date string, e.g. "2026-05-15"
  modifiedDate?: string;
}

const {
  title = "Commit — Indexing Reality",
  description = "Google indexed the web. The next step is indexing reality. Commit captures behavioral commitment signals — the data layer AI needs to give trustworthy recommendations.",
  canonical = "https://getcommit.dev",
  publishDate,
  modifiedDate,
} = Astro.props;

// Strip " — Commit" suffix from title for structured data headline and OG cards
const headline = title.replace(/\s*[—–-]\s*Commit\s*$/, "");

// Dynamic OG image: blog posts get a generated card, everything else uses the default
const OG_API = "https://poc-backend.amdal-dev.workers.dev";
const isBlogPost = canonical.includes("/blog/") && canonical !== "https://getcommit.dev/blog" && canonical !== "https://getcommit.dev/blog/";
const ogImage =
  Astro.props.ogImage ??
  (isBlogPost
    ? `${OG_API}/og/blog?title=${encodeURIComponent(headline)}`
    : "https://getcommit.dev/og-default.png");

// Related posts for blog pages — keyword overlap in title + description
const STOP_WORDS = new Set([
  'the','a','an','is','are','was','were','in','on','at','to','for','of','with',
  'by','from','and','or','not','no','but','what','how','why','when','where',
  'who','which','that','this','it','its','here','there','has','have','had',
  'do','does','did','will','would','could','should','can','may','might',
  'just','about','over','i','you','we','they','my','your','our','their',
  'if','than','then','so','too','very','all','any','each','every','both',
  'few','more','most','other','some','such','only','same','own','one','two',
  'now','new','also','been','being','get','got','dont','heres','whats','thats',
]);

function tokenize(text: string): Set<string> {
  return new Set(
    text.toLowerCase()
      .replace(/[^a-z0-9\s-]/g, ' ')
      .split(/\s+/)
      .filter(w => w.length > 2 && !STOP_WORDS.has(w))
  );
}

type ScoredPost = typeof posts[number] & { _score: number };
let relatedPosts: typeof posts = [];

if (isBlogPost) {
  const currentSlug = canonical
    .replace('https://getcommit.dev/blog/', '')
    .replace(/\/$/, '');
  const currentPost = posts.find(p => p.slug === currentSlug);

  if (currentPost) {
    // Author-curated override beats the token-overlap heuristic. Used when
    // the algorithm sends engaged readers to a tangential post instead of the
    // intended deep-dive. Unknown slugs are silently dropped so a typo can't
    // surface a missing post.
    if (currentPost.relatedSlugs && currentPost.relatedSlugs.length > 0) {
      relatedPosts = currentPost.relatedSlugs
        .map(slug => posts.find(p => p.slug === slug))
        .filter((p): p is typeof posts[number] => p !== undefined)
        .slice(0, 3);
    } else {
      const currentTokens = tokenize(currentPost.title + ' ' + currentPost.description);

      relatedPosts = (posts
        .filter(p => p.slug !== currentSlug)
        .map(p => {
          const tokens = tokenize(p.title + ' ' + p.description);
          let score = 0;
          for (const t of tokens) {
            if (currentTokens.has(t)) score++;
          }
          return { ...p, _score: score } as ScoredPost;
        })
        .sort((a, b) => b._score - a._score)
        .slice(0, 3) as typeof posts);
    }
  }
}

// JSON-LD structured data
//
// Single source of truth for schema.org markup across the site. Uses @graph so
// each page can declare multiple typed entries (Organization + WebSite + Product
// on the homepage, Organization + Product + FAQPage on /pricing, etc.) and they
// cross-reference via @id. AI assistants and Google Rich Results both prefer a
// single @graph block over multiple sibling <script> tags.
//
// Stable @ids used across pages:
//   https://getcommit.dev/#org      — Organization (Commit)
//   https://getcommit.dev/#website  — WebSite (search action)
//   https://getcommit.dev/#product  — Product (Commit API + tiers)

const ORG_ID = "https://getcommit.dev/#org";
const WEBSITE_ID = "https://getcommit.dev/#website";
const PRODUCT_ID = "https://getcommit.dev/#product";

const ORGANIZATION = {
  "@type": "Organization",
  "@id": ORG_ID,
  "name": "Commit",
  "alternateName": "getcommit.dev",
  "url": "https://getcommit.dev",
  "logo": {
    "@type": "ImageObject",
    "url": "https://getcommit.dev/og-default.png",
    "width": 1200,
    "height": 630,
  },
  "description":
    "Behavioral commitment signals for software supply chain risk. Scores npm, PyPI, Cargo, and Go packages on publisher depth, release patterns, and maintenance consistency.",
  "sameAs": [
    "https://github.com/piiiico/proof-of-commitment",
    "https://www.npmjs.com/package/proof-of-commitment",
  ],
  // hasOfferCatalog declares the public-facing API products. AEO analyzers
  // (Synlig + Schema App Validator) read this as the canonical service surface.
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Commit API plans",
    "url": "https://getcommit.dev/pricing/",
    "itemListElement": [
      {
        "@type": "OfferCatalog",
        "name": "Supply-chain risk scoring",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Free package audit",
              "description":
                "Audit any npm, PyPI, Cargo, or Go package via CLI or web — free, no signup required.",
            },
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "REST API access",
              "description":
                "Programmatic access to risk scores: single-package + batch endpoints, MCP server, IDE hooks for Cursor / Claude Code / Windsurf.",
            },
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Continuous monitoring",
              "description":
                "Watch packages, repos, or projects — daily / hourly scans, email + Slack + webhook alerts the moment a score drops.",
            },
          },
        ],
      },
    ],
  },
};

const WEBSITE_NODE = {
  "@type": "WebSite",
  "@id": WEBSITE_ID,
  "url": "https://getcommit.dev",
  "name": "Commit",
  "publisher": { "@id": ORG_ID },
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://getcommit.dev/audit?packages={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};

// Offers and FAQ live with pricing — keep them next to the canonical source so
// when /pricing copy changes, the structured data changes in the same edit.
// Prices/usage limits mirror pricing.astro tier cards exactly; treat as a contract.
const PRICING_OFFERS = [
  {
    "@type": "Offer",
    "name": "Free",
    "price": "0",
    "priceCurrency": "USD",
    "category": "FreeTrial",
    "description":
      "Single-package API — 200 req/day with free API key. CLI, web audit, MCP server unlimited. Watchlist for 3 packages with weekly digest.",
    "availability": "https://schema.org/InStock",
    "url": "https://getcommit.dev/get-started/",
  },
  {
    "@type": "Offer",
    "name": "Developer",
    "price": "15",
    "priceCurrency": "USD",
    "billingDuration": "P1M",
    "description":
      "Single-package API 1,000 req/day, batch API up to 5 packages (2,000 req/month), GitHub repo audit 50 req/month, watchlist 15 packages with daily scans + instant email alerts.",
    "availability": "https://schema.org/InStock",
    "url": "https://getcommit.dev/pricing/#developer",
  },
  {
    "@type": "Offer",
    "name": "Pro",
    "price": "29",
    "priceCurrency": "USD",
    "billingDuration": "P1M",
    "description":
      "Batch API up to 20 packages (10,000 req/month pooled), GitHub repo audit 500 req/month, dependency graph 200 req/month, monitor 10 projects, Slack/webhook alerts, 90-day history.",
    "availability": "https://schema.org/InStock",
    "url": "https://getcommit.dev/pricing/#pro",
  },
  {
    "@type": "Offer",
    "name": "Enterprise",
    "price": "199",
    "priceCurrency": "USD",
    "billingDuration": "P1M",
    "description":
      "Everything in Pro plus unlimited projects, hourly scans, SSO, SOC 2 evidence, dedicated support.",
    "availability": "https://schema.org/InStock",
    "url": "https://getcommit.dev/pricing/#enterprise",
  },
];

const PRICING_FAQ = [
  {
    q: "What's the difference between Developer and Pro?",
    a:
      "Developer ($15/mo) is for builders: 5× more API requests than free, batch scanning for up to 5 packages, GitHub Action auto-triggers on PR, and monitoring for 15 packages with daily scans and instant email alerts. Pro ($29/mo) is for teams in production: 10,000 requests/month pooled, batch up to 20 packages, 10 monitored projects, Slack/webhook alerts, 90-day history, and priority badge CDN.",
  },
  {
    q: "Why per-project, not per-seat?",
    a:
      "Per-seat pricing creates perverse incentives: teams avoid adding contributors to save costs, and security coverage gets gaps. Commit's data comes from public registries — we don't touch your code, so we don't need to count seats. A growing team shouldn't cost more for the same security coverage.",
  },
  {
    q: "Is Commit replacing Socket or Snyk?",
    a:
      "No. Use all of them. Socket detects malicious code after it's published. Snyk finds known CVEs. Commit identifies structural exposure before any code changes — it maps which packages are the kind of thing that gets targeted. The ua-parser-js attack (October 2021) triggered zero warnings in Socket or Snyk beforehand. The structural signal — 1 maintainer, 100M+ downloads/week — was visible for years.",
  },
  {
    q: "What counts as a project for Pro monitoring?",
    a:
      "A project is a dependency manifest you want Commit to monitor continuously — typically a package.json or GitHub repository. Pro covers 10 projects with daily scans. Enterprise covers unlimited projects with hourly scans. Single-package audits via the API don't count toward your project limit.",
  },
  {
    q: "Is the CLI really free forever?",
    a:
      "Yes. The CLI (npx proof-of-commitment), the scoring algorithm, and the web audit tool are MIT-licensed and free forever. The value in Pro and Enterprise isn't the algorithm (it's public) — it's the infrastructure: monitoring, alerts, historical data, and CI/CD integration.",
  },
  {
    q: "What's the API rate limit on the free tier?",
    a:
      "Free tier: 200 single-package requests per day with a free API key (instant signup at /get-started, no card). Anonymous (no key): 15/day per IP. Batch requests (up to 5 packages) come with Developer ($15/mo); up to 20 packages with Pro ($29/mo). If you hit the limit, the API returns HTTP 429 with a Retry-After header.",
  },
];

const COMMIT_PRODUCT = {
  "@type": "SoftwareApplication",
  "@id": PRODUCT_ID,
  "name": "Commit",
  "alternateName": "Commit Index",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Web, CLI (Node.js), MCP",
  "url": "https://getcommit.dev",
  "publisher": { "@id": ORG_ID },
  "description":
    "Score npm, PyPI, Cargo, and Go packages on behavioral commitment signals — publisher depth, release patterns, maintenance consistency. Both axios and node-ipc scored CRITICAL before they were attacked.",
  "featureList": [
    "CLI (npx proof-of-commitment)",
    "Web audit",
    "REST API",
    "MCP server",
    "GitHub Action",
    "Cursor / Claude Code / Windsurf hook",
  ],
  "offers": PRICING_OFFERS,
};

const FAQ_NODE = {
  "@type": "FAQPage",
  "@id": "https://getcommit.dev/pricing/#faq",
  "mainEntity": PRICING_FAQ.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
};

function wrapGraph(nodes: any[]): string {
  return JSON.stringify({
    "@context": "https://schema.org",
    "@graph": nodes,
  });
}

function buildJsonLd(): string | null {
  if (isBlogPost) {
    const article: Record<string, any> = {
      "@type": "BlogPosting",
      "@id": canonical + "#post",
      "headline": headline,
      "description": description,
      "url": canonical,
      "image": ogImage,
      "author": {
        "@type": "Person",
        "name": "Håkon Åmdal",
        "url": "https://getcommit.dev",
      },
      "publisher": { "@id": ORG_ID },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonical,
      },
    };
    if (publishDate) article.datePublished = publishDate;
    if (modifiedDate) article.dateModified = modifiedDate;
    return wrapGraph([ORGANIZATION, article]);
  }

  if (canonical === "https://getcommit.dev" || canonical === "https://getcommit.dev/") {
    return wrapGraph([ORGANIZATION, WEBSITE_NODE, COMMIT_PRODUCT]);
  }

  if (canonical.includes("/pricing")) {
    // Pricing page surfaces all offers + FAQ — the canonical AI-assistant
    // citation target for "how much does Commit cost" / "what's in Pro tier"
    // / "is Commit replacing Snyk".
    return wrapGraph([ORGANIZATION, COMMIT_PRODUCT, FAQ_NODE]);
  }

  // Software tool pages
  if (canonical.includes("/audit") || canonical.includes("/scan")) {
    return wrapGraph([
      ORGANIZATION,
      {
        "@type": "SoftwareApplication",
        "@id": canonical + "#tool",
        "name": "Commit — Supply Chain Auditing",
        "url": canonical,
        "description": description,
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Web",
        "publisher": { "@id": ORG_ID },
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock",
        },
      },
    ]);
  }

  // All other pages get Organization at minimum so the Knowledge Graph has a
  // stable @id to bind citations to no matter which page an assistant lands on.
  return wrapGraph([ORGANIZATION]);
}

const jsonLd = buildJsonLd();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />

  <!-- Theme color (warm paper) -->
  <meta name="theme-color" content="#FFFCF0" />

  <!-- Feed discovery -->
  <link rel="alternate" type="application/rss+xml" title="Commit Blog" href="https://getcommit.dev/blog/rss.xml" />
  <link rel="alternate" type="application/feed+json" title="Commit Blog" href="https://getcommit.dev/blog/feed.json" />

  <!-- JSON-LD Structured Data -->
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

  {/*
    First-party visit beacon — replaces CF Web Analytics, which has been
    silently producing zero data since 2026-05-24 (POST /cdn-cgi/rum 404s).
    Posts to poc-backend with utm_* preserved so funnel-attribution surfaces
    (audit-overshoot, audit-compromised-key, audit-web-compromised, key-upgrade)
    show up in /api/v1/visits/stats. Fire-and-forget; sendBeacon when available
    so navigation isn't blocked. No cookies, no fingerprinting, no PII.
  */}
  <script is:inline>
    (function() {
      try {
        var url = new URL(window.location.href);
        var params = url.searchParams;
        var payload = {
          path: url.pathname,
          referrer: document.referrer || "",
          utm_source: params.get("utm_source") || undefined,
          utm_medium: params.get("utm_medium") || undefined,
          utm_campaign: params.get("utm_campaign") || undefined,
          utm_content: params.get("utm_content") || undefined,
          utm_term: params.get("utm_term") || undefined
        };
        // Strip undefined keys so the JSON stays compact.
        Object.keys(payload).forEach(function(k) {
          if (payload[k] === undefined) delete payload[k];
        });
        var endpoint = "https://poc-backend.amdal-dev.workers.dev/api/v1/visit";
        var body = JSON.stringify(payload);
        // Send as text/plain — CORS-safelisted content-type, so no preflight
        // OPTIONS is required. Backend parses text body as JSON regardless of
        // Content-Type. Skipping preflight is faster AND sidesteps a
        // headless-chromium preflight glitch (cors-error 11) reproducible
        // 2026-06-10 with application/json Blobs.
        var blob = new Blob([body], { type: "text/plain" });
        // Prefer sendBeacon — fire-and-forget, navigation-safe.
        if (navigator.sendBeacon && navigator.sendBeacon(endpoint, blob)) return;
        // Fallback: keepalive fetch with text/plain so the simple-request path
        // is still used (no preflight). Don't await — beacon must not block paint.
        fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "text/plain" },
          body: body,
          keepalive: true,
          credentials: "omit"
        }).catch(function() { /* swallow — analytics never breaks the page */ });
      } catch (e) { /* swallow — analytics never breaks the page */ }
    })();
  </script>
</head>
<body>
  <slot />

  {isBlogPost && relatedPosts.length > 0 && (
    <section class="related-posts-section">
      <div class="container" style="max-width: var(--max-content); margin: 0 auto; padding: 0 2rem;">
        <hr style="border: none; border-top: 1px solid var(--border); margin-bottom: 2rem;" />
        <p style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-subtle); margin-bottom: 1.25rem; font-family: var(--font-body);">Keep reading</p>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem;">
          {relatedPosts.map(p => (
            <li>
              <a href={`/blog/${p.slug}`} style="text-decoration: none; display: block; padding: 1rem 1.25rem; border: 1px solid var(--border-light); border-radius: 6px; background: var(--paper-dim); transition: border-color 0.15s ease;">
                <span style="display: block; font-family: var(--font-body); font-size: 0.95rem; font-weight: 500; color: var(--ink); line-height: 1.4;">{p.title}</span>
                <span style="display: block; font-size: 0.8rem; color: var(--ink-subtle); margin-top: 0.35rem; font-family: var(--font-body);">{p.dateLabel}</span>
              </a>
            </li>
          ))}
        </ul>
        <div style="margin-top: 1.5rem; margin-bottom: 3rem;">
          <a href="/blog" style="font-size: 0.85rem; color: var(--accent); text-decoration: none; font-family: var(--font-body); font-weight: 500;">&larr; All writing</a>
        </div>
      </div>
    </section>
  )}

  <script is:inline>
    // Route handler for /scan/* — when served as SPA fallback, redirect to scan page
    // Must be inline (not bundled) so it runs before any rendering
    // Excludes /scan/repo which is a real page (repo scanner)
    (function() {
      var p = window.location.pathname;
      if (p === '/scan/repo' || p === '/scan/repo/') return;
      var m = p.match(/^\/scan\/([^/]+)\/?$/);
      if (m) window.location.replace('/scan/?pkg=' + encodeURIComponent(decodeURIComponent(m[1])));
    })();
  </script>

  <script>
    // Scroll reveal — IntersectionObserver
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -48px 0px' }
    );

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
