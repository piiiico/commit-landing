---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — Commit"
  description="The page you're looking for doesn't exist. Audit any npm, PyPI, Cargo, or Go package by name."
  canonical="https://getcommit.dev/404"
>

  <!-- Nav -->
  <nav>
    <div class="container nav-inner">
      <a href="/" class="nav-brand">Commit</a>
      <ul class="nav-links">
        <li><a href="/audit">Audit</a></li>
        <li><a href="/rankings">Rankings</a></li>
        <li><a href="/blog">Writing</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/docs">Docs</a></li>
        <li><a href="https://github.com/piiiico/proof-of-commitment" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </div>
  </nav>

  <section class="hero" style="padding-top: 6rem; padding-bottom: 6rem;">
    <div class="container">
      <div class="editorial" style="max-width: 640px; margin: 0 auto; text-align: center;">
        <p id="nf-eyebrow" style="font-family: 'Inter', system-ui, sans-serif; font-size: 0.875rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-light); margin-bottom: 1rem;">
          404 &mdash; not found
        </p>
        <h1 id="nf-title" class="hero-title" style="font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: 1.25rem;">
          That page isn&rsquo;t on Commit.
        </h1>
        <p id="nf-sub" class="hero-sub" style="color: var(--ink-light); margin-bottom: 2.5rem; font-size: 1.05rem; line-height: 1.6;">
          Maybe the URL has a typo. If you came here looking for a package score, try the audit tool &mdash; it covers npm, PyPI, Cargo, and Go.
        </p>

        <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem;">
          <a id="nf-cta-primary" href="/audit/" class="btn-primary" style="display: inline-block; padding: 0.75rem 1.5rem; background: var(--ink); color: var(--bg); text-decoration: none; border-radius: 4px; font-weight: 500;">
            Audit your dependencies &rarr;
          </a>
          <a href="/rankings/" class="btn-ghost" style="display: inline-block; padding: 0.75rem 1.5rem; background: transparent; color: var(--ink); border: 1px solid var(--border); text-decoration: none; border-radius: 4px; font-weight: 500;">
            Browse rankings &rarr;
          </a>
        </div>

        <p style="color: var(--ink-light); font-size: 0.9rem; margin-bottom: 0.5rem;">
          Popular destinations:
        </p>
        <p style="font-size: 0.9rem;">
          <a href="/package/axios/" style="color: var(--ink); text-decoration: underline; margin: 0 0.5rem;">axios</a>
          <a href="/package/chalk/" style="color: var(--ink); text-decoration: underline; margin: 0 0.5rem;">chalk</a>
          <a href="/package/zod/" style="color: var(--ink); text-decoration: underline; margin: 0 0.5rem;">zod</a>
          <a href="/pypi/litellm" style="color: var(--ink); text-decoration: underline; margin: 0 0.5rem;">litellm</a>
          <a href="/pypi/fastapi" style="color: var(--ink); text-decoration: underline; margin: 0 0.5rem;">fastapi</a>
          <a href="/blog/" style="color: var(--ink); text-decoration: underline; margin: 0 0.5rem;">blog</a>
        </p>
      </div>
    </div>
  </section>

  <footer style="border-top: 1px solid var(--border); padding: 2rem 0; margin-top: 4rem;">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <span style="color: var(--ink-light); font-size: 0.875rem;">&copy; 2026 Commit</span>
      <a href="/privacy" style="color: var(--ink-light); font-size: 0.875rem; text-decoration: none;">Privacy</a>
    </div>
  </footer>

  <!--
    Context-aware 404: if the user landed on /package/<unknown>/ or /pypi/<x>
    style URLs, deep-link the CTA into /audit so the typo becomes a working
    scan instead of a dead end. Net: this page swaps a 200-with-homepage SEO
    leak for a real 404 with a conversion shortcut.
  -->
  <script is:inline>
    (function () {
      try {
        var path = (location.pathname || '').replace(/^\/+|\/+$/g, '');
        if (!path) return;
        var seg = path.split('/');
        var head = seg[0] || '';
        var tail = decodeURIComponent(seg.slice(1).join('/') || '');
        var ecosystem = '';
        var pkg = '';
        if (head === 'package' && tail) { ecosystem = 'npm'; pkg = tail.replace(/__/g, '/'); }
        else if (head === 'npm' && tail) { ecosystem = 'npm'; pkg = tail; }
        else if (head === 'pypi' && tail) { ecosystem = 'pypi'; pkg = tail; }
        else if (head === 'cargo' && tail) { ecosystem = 'cargo'; pkg = tail; }
        else if (head === 'go' && tail) { ecosystem = 'go'; pkg = tail; }
        if (!ecosystem || !pkg) return;
        // Sanitize: package-name shape only (conservative).
        if (!/^[@a-z0-9][a-z0-9._/@-]{0,99}$/i.test(pkg)) return;
        var titleEl = document.getElementById('nf-title');
        var subEl = document.getElementById('nf-sub');
        var ctaEl = document.getElementById('nf-cta-primary');
        if (titleEl) titleEl.textContent = 'No profile for "' + pkg + '" yet.';
        if (subEl) subEl.innerHTML = 'We don’t have a static profile page for <code>' + pkg.replace(/[<>&"]/g, '') + '</code> on ' + ecosystem + '. Run a live audit and you’ll get the score in seconds.';
        if (ctaEl) ctaEl.setAttribute('href', '/audit/?packages=' + encodeURIComponent(pkg) + '&ecosystem=' + ecosystem);
        if (ctaEl) ctaEl.textContent = 'Audit ' + pkg + ' →';
      } catch (_) { /* no-op */ }
    })();
  </script>

</Layout>
