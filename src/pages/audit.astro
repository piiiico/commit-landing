      margin-top: 2.5rem;
      padding: 1.5rem;
      background: var(--paper-dim);
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    .mcp-cta-label {
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--ink-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.75rem;
    }

    .code-block {
      background: var(--ink);
      color: #a8c6fa;
      padding: 1rem;
      border-radius: 4px;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      line-height: 1.6;
      overflow-x: auto;
      margin-bottom: 0.75rem;
    }

    .mcp-cta-hint {
      font-size: 0.85rem;
      color: var(--ink-muted);
    }

