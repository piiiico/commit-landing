---
import Layout from '../layouts/Layout.astro';

// Live npm stats for the hero claim. Hardcoded values drift fast:
// chalk grew 418M → 438M, zod 158M → 178M, axios 99M → 109M, hono 34M → 39M
// between deploys. Pull current numbers at build time so "right now" is true.
// Falls back to last-known values if the npm API is unreachable mid-build.
interface PkgStat { name: string; weekly: number; maintainers: number; }
const FALLBACK: PkgStat[] = [
  { name: 'chalk',  weekly: 438_000_000, maintainers: 1 },
  { name: 'zod',    weekly: 178_000_000, maintainers: 1 },
  { name: 'lodash', weekly: 155_000_000, maintainers: 1 },
  { name: 'axios',  weekly: 109_000_000, maintainers: 1 },
];
const CANDIDATES = ['chalk', 'zod', 'axios', 'lodash', 'hono', 'dotenv', 'uuid'];
let critical: PkgStat[] = FALLBACK;
try {
  const fetched = await Promise.all(CANDIDATES.map(async (name) => {
    const [dl, reg] = await Promise.all([
      fetch(`https://api.npmjs.org/downloads/point/last-week/${name}`).then(r => r.json()),
      fetch(`https://registry.npmjs.org/${name}`).then(r => r.json()),
    ]);
    return { name, weekly: dl.downloads as number, maintainers: (reg.maintainers || []).length };
  }));
  // CRITICAL = single maintainer + >10M weekly downloads (page's own definition).
  const fresh = fetched.filter(p => p.maintainers === 1 && p.weekly > 10_000_000)
                       .sort((a, b) => b.weekly - a.weekly)
                       .slice(0, 4);
  if (fresh.length >= 4) critical = fresh;
} catch (err) {
  console.warn('[audit.astro] npm stats fetch failed, using fallback:', err);
}
const fmtM = (n: number) => Math.round(n / 1_000_000) + 'M';
const numWord = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five'][critical.length] ?? `${critical.length}`;
const heroFirst  = `${critical[0].name} (${fmtM(critical[0].weekly)} downloads/week, ${critical[0].maintainers} maintainer)`;
const heroOthers = critical.slice(1).map(p => `${p.name} (${fmtM(p.weekly)}, ${p.maintainers} maintainer)`).join(', ');
const auditHeroClaim = `${numWord} packages in a typical project are CRITICAL right now: ${heroFirst}, ${heroOthers}.`;
---

<Layout
  title="Dependency Audit — Commit"
  description="Paste your npm or PyPI packages. Get behavioral risk scores in seconds. CRITICAL = single maintainer + 10M+ weekly downloads."
  canonical="https://getcommit.dev/audit/"
>
  <!-- Nav -->
  <nav>
    <div class="container nav-inner">
      <a href="/" class="nav-brand">Commit</a>
      <ul class="nav-links">
        <li><a href="/#mcp">MCP</a></li>
        <li><a href="/audit" class="nav-active">Audit</a></li>
        <li><a href="/watchlist">Watchlist</a></li>
        <li><a href="/extension">Extension</a></li>
        <li><a href="/badges">Badges</a></li>
        <li><a href="/blog">Writing</a></li>
        <li><a href="/pricing">Pricing</a></li><li><a href="/docs">Docs</a></li><li><a href="https://github.com/piiiico/proof-of-commitment" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="mailto:pico@amdal.dev">Contact</a></li>
      </ul>
    </div>
  </nav>

  <section class="audit-hero">
    <div class="container">
      <div class="editorial" style="max-width: var(--max-content); margin: 0 auto;">
        <span class="hero-eyebrow">Supply chain risk scanner</span>
        <h1 class="audit-title">
          Paste your dependencies.<br />
          <em>See what's hiding.</em>
        </h1>
        <p class="audit-lead">
          {auditHeroClaim}
          Stars and READMEs don't show this. Behavioral signals do.
        </p>
        <p style="margin-top: 1rem; font-size: 0.95rem;">
          Have a GitHub URL? <a href="/scan/repo" style="color: var(--accent); text-decoration: none; font-weight: 500;">Scan the whole repo in one click &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <section class="audit-tool">
    <div class="container">
      <div class="audit-card">
        <!-- Ecosystem tabs -->
        <div class="eco-tabs" role="tablist">
          <button class="eco-tab active" data-eco="npm" role="tab" aria-selected="true">npm</button>
          <button class="eco-tab" data-eco="pypi" role="tab" aria-selected="false">PyPI</button>
          <button class="eco-tab" data-eco="cargo" role="tab" aria-selected="false">Cargo</button>
          <button class="eco-tab" data-eco="golang" role="tab" aria-selected="false">Go</button>
          <button class="eco-tab" data-eco="github" role="tab" aria-selected="false">GitHub repo</button>
        </div>

        <!-- Input area (npm/pypi) -->
        <div id="pkg-input-area" class="input-area">
          <label class="input-label" for="packages-input">
            Package names — one per line, or comma-separated (max 20)
          </label>
          <textarea
            id="packages-input"
            class="packages-input"
            rows="6"
            placeholder="axios&#10;zod&#10;chalk&#10;lodash&#10;express&#10;dotenv&#10;uuid"
            spellcheck="false"
          >axios
zod
chalk
lodash
express
dotenv
uuid</textarea>
        </div>

        <!-- GitHub input area -->
        <div id="github-input-area" class="input-area" hidden>
          <label class="input-label" for="github-repo-input">
            GitHub repo URL or owner/repo slug
          </label>
          <input
            id="github-repo-input"
            class="github-repo-input"
            type="text"
            placeholder="vercel/ai  or  https://github.com/langchain-ai/langchainjs"
            autocomplete="off"
            spellcheck="false"
          />
          <p class="github-input-hint">
            Fetches <code>package.json</code> / <code>requirements.txt</code> directly — no copy-paste needed.
            Try: <button class="example-repo" data-repo="vercel/ai">vercel/ai</button>
            · <button class="example-repo" data-repo="anthropics/anthropic-sdk-python">anthropic SDK</button>
            · <button class="example-repo" data-repo="facebook/react">react</button>
          </p>
        </div>

        <!-- Drop zone (package/project files) -->
        <div id="drop-zone" class="drop-zone">
          <span class="drop-icon">↓</span>
          <span class="drop-label">Drop <code>package.json</code>, <code>package-lock.json</code>, <code>yarn.lock</code>, <code>pnpm-lock.yaml</code>, <code>requirements.txt</code>, <code>Cargo.toml</code>, <code>go.mod</code>, or <code>go.sum</code></span>
          <span class="drop-hint">Lock files scan ALL transitive dependencies — not just the top 20</span>
        </div>

        <button id="audit-btn" class="audit-submit">
          Audit dependencies
        </button>

        <p class="audit-note">
          No install. No API key. Lock files scan all transitive deps (top 20 shown).
          <a href="https://github.com/piiiico/proof-of-commitment" target="_blank" rel="noopener">Source code →</a>
        </p>
      </div>

      <!-- Results -->
      <div id="results-area" class="results-area" hidden>
        <div class="results-summary" id="results-summary"></div>
        <div class="share-row" id="share-row">
          <button id="share-btn" class="share-btn">↗ Copy link</button>
          <span class="share-copied" id="share-copied" hidden>Link copied!</span>
          <button id="download-btn" class="share-btn">↓ Download report</button>
        </div>
        <div class="results-table-wrap">
          <table class="results-table" id="results-table">
            <thead>
              <tr>
                <th>Package</th>
                <th>Score</th>
                <th>Risk</th>
                <th id="th-maintainers">Maintainers</th>
                <th>Weekly DL</th>
                <th>Age</th>
                <th>Trend</th>
              </tr>
            </thead>
            <tbody id="results-body"></tbody>
          </table>
        </div>

        <!-- Dynamic post-results CTA — shown when CRITICAL packages found -->
        <div id="post-results-cta" class="post-results-cta" hidden></div>

        <div class="mcp-cta">
          <p class="mcp-cta-label">Want this in your AI assistant?</p>
          <pre class="code-block">{`{
  "mcpServers": {
    "commit": {
      "type": "streamable-http",
      "url": "https://poc-backend.amdal-dev.workers.dev/mcp"
    }
  }
}`}</pre>
          <p class="mcp-cta-hint">Add to Claude Desktop, Cursor, or any MCP client. Then: <em>"Audit my package.json for supply chain risk"</em></p>
        </div>
      </div>

      <!-- Loading state -->
      <div id="loading-area" class="loading-area" hidden>
        <div class="loading-spinner"></div>
        <p>Scoring packages…</p>
      </div>

      <!-- Error state -->
      <div id="error-area" class="error-area" hidden>
        <p id="error-message"></p>
      </div>
    </div>
  </section>

  <!-- Dependency Tree Explorer -->
  <section class="dep-tree-section">
    <div class="container">
      <div class="editorial" style="max-width: var(--max-content); margin: 0 auto;">
        <span class="hero-eyebrow">Transitive risk</span>
        <h2 class="section-heading dep-tree-heading">
          The risks you don't see coming
        </h2>
        <p class="dep-tree-intro">
          Your package may look fine. Its dependencies may not.
          The Anthropic SDK scores healthy — but two of its transitive dependencies are CRITICAL.
          Neither shows up in a direct audit.
        </p>

        <div class="dep-tree-card">
          <div class="dep-tree-input-row">
            <input
              id="graph-pkg-input"
              class="graph-pkg-input"
              type="text"
              placeholder="e.g. @anthropic-ai/sdk"
              value="@anthropic-ai/sdk"
              autocomplete="off"
              spellcheck="false"
            />
            <div class="depth-selector">
              <label class="depth-label">Depth</label>
              <button class="depth-btn active" data-depth="1">1</button>
              <button class="depth-btn" data-depth="2">2</button>
            </div>
            <button id="graph-btn" class="graph-submit">Explore tree</button>
          </div>
          <p class="dep-tree-note">npm only · max depth 2 · up to 20 nodes</p>
        </div>

        <!-- Tree loading -->
        <div id="graph-loading" class="graph-loading" hidden>
          <div class="loading-spinner"></div>
          <p>Mapping dependency tree…</p>
        </div>

        <!-- Tree error -->
        <div id="graph-error" class="error-area" hidden>
          <p id="graph-error-msg"></p>
        </div>

        <!-- Tree output -->
        <div id="graph-results" class="graph-results" hidden>
          <div class="graph-summary" id="graph-summary"></div>
          <div class="tree-output" id="tree-output"></div>
          <div class="critical-paths" id="critical-paths"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="how-it-works">
    <div class="container">
      <div class="editorial" style="max-width: var(--max-content); margin: 0 auto;">
        <h2 class="section-heading">What the score measures</h2>
        <div class="signal-grid">
          <div class="signal-item">
            <span class="signal-name">Longevity</span>
            <span class="signal-desc">How long has this package existed? Abandoned projects get reactivated for attacks.</span>
          </div>
          <div class="signal-item">
            <span class="signal-name">Maintainer depth</span>
            <span class="signal-desc">Single maintainer + millions of weekly downloads = the attack surface LiteLLM exploited.</span>
          </div>
          <div class="signal-item">
            <span class="signal-name">Release consistency</span>
            <span class="signal-desc">Regular releases signal active oversight. Long gaps = vulnerability accumulation.</span>
          </div>
          <div class="signal-item">
            <span class="signal-name">Download trend</span>
            <span class="signal-desc">Growing packages attract more scrutiny (and attacks). Stable = lower profile.</span>
          </div>
        </div>
        <p class="how-note">
          Risk flags: <strong>CRITICAL</strong> = single maintainer + &gt;10M weekly downloads (the ua-parser-js/event-stream attack profile).
          <strong>HIGH</strong> = package &lt;1yr old + rapid adoption.
          <strong>WARN</strong> = no release in 12+ months.
        </p>
      </div>
    </div>
  </section>

  <!-- Direct-to-revenue CTA (replaced dead /api/waitlist 404 form 2026-05-22) -->
  <section class="audit-waitlist-section">
    <div class="container">
      <div class="audit-waitlist-inner reveal">
        <p class="audit-waitlist-label">Run this in CI? Audit every push.</p>
        <a href="/get-started?ref=audit-web" class="audit-waitlist-btn" data-cta="audit-get-key">
          Get your free API key →
        </a>
        <span class="audit-waitlist-hint">200 audits/day · no credit card</span>
      </div>
    </div>
  </section>

  <style>
    .nav-active {
      color: var(--accent) !important;
      font-weight: 500;
    }

    .audit-hero {
      padding: 6rem 0 3rem;
      background: var(--paper);
    }

    .audit-title {
      font-family: var(--font-display);
      font-size: clamp(2.2rem, 5vw, 3.5rem);
      line-height: 1.12;
      color: var(--ink);
      margin: 1rem 0 1.5rem;
    }

    .audit-title em {
      font-style: italic;
      color: var(--accent);
    }

    .audit-lead {
      font-size: 1.05rem;
      line-height: 1.7;
      color: var(--ink-muted);
      max-width: 42rem;
    }

    /* ── Audit Card ── */
    .audit-tool {
      padding: 3rem 0 4rem;
      background: var(--paper);
    }

    .audit-card {
      background: var(--paper-dim);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 2rem;
      max-width: 48rem;
      margin: 0 auto 2rem;
    }

    .eco-tabs {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .eco-tab {
      padding: 0.4rem 1rem;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--ink-muted);
      font-family: var(--font-mono);
      font-size: 0.85rem;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.15s;
    }

    .eco-tab.active {
      background: var(--ink);
      color: var(--paper);
      border-color: var(--ink);
    }

    .input-label {
      display: block;
      font-size: 0.85rem;
      color: var(--ink-muted);
      margin-bottom: 0.5rem;
    }

    .packages-input {
      width: 100%;
      padding: 0.75rem 1rem;
      font-family: var(--font-mono);
      font-size: 0.9rem;
      background: var(--paper);
      border: 1px solid var(--border);
      border-radius: 4px;
      color: var(--ink);
      resize: vertical;
      transition: border-color 0.15s;
      line-height: 1.6;
    }

    .packages-input:focus {
      outline: none;
      border-color: var(--accent);
    }

    .audit-submit {
      margin-top: 1rem;
      padding: 0.75rem 2rem;
      background: var(--accent);
      color: white;
      border: none;
      border-radius: 4px;
      font-family: var(--font-body);
      font-size: 0.95rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s;
    }

    .audit-submit:hover {
      background: var(--accent-dim);
    }

    .audit-submit:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .drop-zone {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      margin: 0.75rem 0;
      padding: 1rem;
      border: 1.5px dashed var(--border);
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s;
      text-align: center;
    }

    .drop-zone:hover,
    .drop-zone.drag-over {
      border-color: var(--accent);
      background: #fff8f5;
    }

    .drop-icon {
      font-size: 1.3rem;
      color: var(--ink-muted);
      line-height: 1;
    }

    .drop-label {
      font-size: 0.85rem;
      color: var(--ink-muted);
    }

    .drop-label code {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      background: var(--paper);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 0 0.3em;
    }

    .drop-hint {
      font-size: 0.75rem;
      color: var(--ink-subtle);
    }

    .audit-note {
      margin-top: 0.75rem;
      font-size: 0.8rem;
      color: var(--ink-subtle);
    }

    .audit-note a {
      color: var(--ink-muted);
    }

    /* ── Results ── */
    .results-area {
      max-width: 60rem;
      margin: 0 auto;
    }

    .results-summary {
      font-size: 0.95rem;
      color: var(--ink-muted);
      margin-bottom: 1rem;
      padding: 0 0.5rem;
    }

    .results-table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    .results-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }

    .results-table th {
      padding: 0.7rem 1rem;
      text-align: left;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--ink-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      background: var(--paper-dim);
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    .results-table td {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--border-light);
      vertical-align: middle;
    }

    .results-table tr:last-child td {
      border-bottom: none;
    }

    .results-table tr:hover td {
      background: var(--paper-dim);
    }

    .result-row {
      cursor: pointer;
    }

    .result-row td:first-child::after {
      content: ' ▸';
      font-size: 0.7rem;
      color: var(--ink-subtle);
      opacity: 0.6;
    }

    .result-row.expanded td:first-child::after {
      content: ' ▾';
    }

    .breakdown-row td {
      padding: 0 1rem 0.75rem 1rem !important;
      background: var(--paper-dim);
      border-bottom: 1px solid var(--border-light) !important;
    }

    .breakdown-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0.75rem;
      padding: 0.75rem 0 0.25rem;
    }

    @media (max-width: 640px) {
      .breakdown-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .breakdown-dim {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .breakdown-label {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink-muted);
      white-space: nowrap;
    }

    .breakdown-bar-wrap {
      height: 5px;
      background: var(--border);
      border-radius: 3px;
      overflow: hidden;
    }

    .breakdown-bar {
      height: 100%;
      border-radius: 3px;
      background: #3d8b3d;
      transition: width 0.3s ease;
    }

    .breakdown-bar.bar-warn {
      background: #c47a0a;
    }

    .breakdown-bar.bar-low {
      background: var(--accent);
    }

    .breakdown-score {
      font-size: 0.75rem;
      font-family: var(--font-mono);
      color: var(--ink-muted);
    }

    .breakdown-max {
      color: var(--ink-subtle);
      font-size: 0.65rem;
    }

    .provenance-badge {
      font-size: 0.72rem;
      vertical-align: middle;
      margin-left: 0.25rem;
      cursor: help;
    }

    .provenance-summary {
      color: #166534;
      font-weight: 500;
    }

    .provenance-summary::before {
      content: '🔒 ';
      font-size: 0.8rem;
    }

    .provenance-note {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      margin-top: 0.75rem;
      padding: 0.6rem 0.875rem;
      border-radius: 0 4px 4px 0;
      font-size: 0.8rem;
      line-height: 1.5;
    }

    .provenance-verified {
      background: #f0fdf4;
      border-left: 3px solid #166534;
      color: #14532d;
    }

    .provenance-none {
      background: #fefce8;
      border-left: 3px solid #a16207;
      color: #713f12;
    }

    .provenance-icon {
      font-size: 0.9rem;
      flex-shrink: 0;
      line-height: 1.5;
    }

    .provenance-note strong {
      font-weight: 600;
    }

    .incident-note {
      margin-top: 0.75rem;
      padding: 0.6rem 0.875rem;
      background: #fff1f2;
      border-left: 3px solid #991b1b;
      border-radius: 0 4px 4px 0;
      font-size: 0.8rem;
      color: #7f1d1d;
      line-height: 1.5;
    }
    .incident-note a {
      color: #991b1b;
      font-weight: 600;
      text-decoration: underline;
    }
    .incident-note strong {
      color: #991b1b;
    }

    .pkg-name {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      color: var(--ink);
      font-weight: 500;
    }

    .score-cell {
      font-family: var(--font-mono);
      font-weight: 600;
    }

    .score-high { color: #3d8b3d; }
    .score-mid { color: #c47a0a; }
    .score-low { color: var(--accent); }

    .risk-badge {
      display: inline-block;
      padding: 0.2rem 0.5rem;
      border-radius: 3px;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.03em;
    }

    .risk-critical {
      background: #fee2e2;
      color: #991b1b;
    }

    .risk-high {
      background: #fef3c7;
      color: #92400e;
    }

    .risk-warn {
      background: #fef9c3;
      color: #713f12;
    }

    .risk-ok {
      background: #dcfce7;
      color: #166534;
    }

    .trend-growing { color: #3d8b3d; }
    .trend-stable { color: var(--ink-muted); }
    .trend-declining { color: var(--accent); }

