    }

    .attack-method {
      color: var(--ink);
      margin-right: 0.35rem;
    }

    .attack-detail { color: var(--ink-muted); }

    .evidence-punchline {
      padding: 1.1rem 1.5rem;
      background: #fff8f5;
      border: 1px solid #fca5a5;
      border-left: 3px solid var(--accent);
