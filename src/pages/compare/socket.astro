    }

    .compare-col-header {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .tool-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 4px;
      font-size: 0.8rem;
      font-weight: 600;
      font-family: var(--font-mono);
    }

    .socket-badge {
      background: #ede9fe;
      color: #5b21b6;
      border: 1px solid #c4b5fd;
    }

    .commit-badge {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid var(--accent);
    }

    .tool-desc {
      font-size: 0.75rem;
      color: var(--ink-subtle);
    }

    .compare-rows {
      max-width: 56rem;
      margin: 0 auto;
    }

    .compare-row {
      display: grid;
      grid-template-columns: 10rem 1fr 1fr;
      gap: 1rem;
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--border-light);
      align-items: start;
    }

    .compare-row:last-child { border-bottom: none; }

    .pkg-info {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding-top: 0.5rem;
    }

    .pkg-name {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--ink);
    }

    .pkg-downloads {
      font-size: 0.75rem;
      color: var(--ink-subtle);
    }

    .compare-cell {
      padding: 0.75rem 1rem;
      border-radius: 6px;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .socket-cell {
      background: #faf5ff;
      border: 1px solid #e9d5ff;
    }

    .socket-ok-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .socket-ok-icon {
      color: #166534;
      font-weight: 700;
    }

    .socket-ok-text {
      font-size: 0.85rem;
      color: #5b21b6;
      font-weight: 500;
    }

    .commit-cell {
      border: 1px solid var(--border);
    }

    .commit-cell.is-critical {
      background: #fff5f5;
      border-color: #fca5a5;
    }

    .commit-cell.is-ok {
      background: #f0fdf4;
      border-color: #bbf7d0;
    }

    .commit-score-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .commit-score {
      font-family: var(--font-mono);
      font-size: 1.2rem;
      font-weight: 700;
    }

    .score-high { color: #3d8b3d; }
    .score-mid { color: #c47a0a; }
    .score-low { color: var(--accent); }

    .risk-badge {
      display: inline-block;
      padding: 0.2rem 0.5rem;
      border-radius: 3px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    .risk-critical {
      background: #fee2e2;
      color: #991b1b;
    }

    .risk-ok {
      background: #dcfce7;
      color: #166534;
    }

    .commit-signals {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .signal-chip {
      font-size: 0.72rem;
      padding: 0.15rem 0.5rem;
      background: var(--paper-dim);
      border: 1px solid var(--border);
      border-radius: 3px;
      color: var(--ink-muted);
      font-family: var(--font-mono);
      white-space: nowrap;
    }

    .signal-chip.danger {
      background: #fee2e2;
      border-color: #fca5a5;
      color: #991b1b;
    }

    .signal-chip.warn {
      background: #fef3c7;
      border-color: #fde68a;
      color: #92400e;
    }

    .signal-chip.good {
      background: #dcfce7;
      border-color: #bbf7d0;
      color: #166534;
    }

    .commit-note {
      font-size: 0.75rem;
      color: var(--ink-muted);
      line-height: 1.4;
    }

    .legend {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      max-width: 56rem;
      margin: 1.5rem auto 0;
      padding: 0.75rem 0;
      border-top: 1px solid var(--border);
      font-size: 0.8rem;
      color: var(--ink-muted);
    }

    .legend-sep { color: var(--border); }

    .loading-state {
      text-align: center;
      padding: 3rem 0;
      color: var(--ink-muted);
      max-width: 56rem;
      margin: 0 auto;
    }

    .loading-spinner {
      width: 2rem;
      height: 2rem;
      border: 2px solid var(--border);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 1rem;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .error-state {
      max-width: 56rem;
      margin: 1rem auto;
      padding: 1rem 1.25rem;
      background: #fee2e2;
      border: 1px solid #fca5a5;
      border-radius: 6px;
      color: #991b1b;
      font-size: 0.9rem;
    }

    @media (max-width: 700px) {
      .compare-header-row,
      .compare-row {
        grid-template-columns: 1fr;
      }
      .compare-header-row { display: none; }
      .compare-row { gap: 0.75rem; }
    }

    /* ── FAQ ── */
    .faq-section {
      padding: 4rem 0;
      background: var(--paper);
    }

    .faq-list {
      display: flex;
      flex-direction: column;
    }

    .faq-item {
      padding: 2rem 0;
      border-top: 1px solid var(--border-light);
    }

    .faq-item:last-child {
      border-bottom: 1px solid var(--border-light);
    }

    .faq-q {
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 400;
      color: var(--ink);
      margin-bottom: 0.75rem;
      line-height: 1.3;
    }

    .faq-a {
      font-size: 0.9375rem;
      color: var(--ink-muted);
      line-height: 1.7;
      max-width: 58ch;
    }

    .faq-link {
      color: var(--accent);
      text-decoration: none;
    }

    .faq-link:hover { text-decoration: underline; }

    /* ── CTA ── */
    .cta-section {
      padding: 5rem 0;
      background: var(--paper-dim);
    }

    .cta-heading {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 400;
      color: var(--ink);
      margin-bottom: 0.75rem;
    }

    .cta-text {
      font-size: 1rem;
      color: var(--ink-muted);
      margin-bottom: 2rem;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .btn-primary {
      padding: 0.85rem 2rem;
      background: var(--accent);
      color: white;
      text-decoration: none;
      border-radius: 4px;
      font-weight: 500;
      font-size: 0.95rem;
      transition: background 0.15s;
    }

    .btn-primary:hover { background: var(--accent-dim); }

    .btn-secondary {
      padding: 0.85rem 2rem;
      background: transparent;
      color: var(--ink);
      text-decoration: none;
      border-radius: 4px;
      font-weight: 500;
      font-size: 0.95rem;
      border: 1px solid var(--border);
      transition: border-color 0.15s;
    }

    .btn-secondary:hover { border-color: var(--ink-subtle); }

    .cli-note {
      margin-top: 0.5rem;
    }

    .cli-note code {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      padding: 0.4rem 0.8rem;
      background: var(--paper);
      border: 1px solid var(--border);
      border-radius: 4px;
      color: var(--ink-muted);
    }

    /* ── Footer ── */
    footer {
      background: var(--paper);
      border-top: 1px solid var(--border);
    }

    .footer-inner {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      padding: 2rem 0;
      flex-wrap: wrap;
    }

    .footer-brand {
      font-family: var(--font-display);
      font-size: 1.1rem;
      color: var(--ink);
    }

    .footer-copy {
      font-size: 0.85rem;
      color: var(--ink-subtle);
      flex: 1;
    }

    .footer-links {
      display: flex;
      gap: 1.25rem;
    }

    .footer-links a {
      font-size: 0.85rem;
      color: var(--ink-muted);
      text-decoration: none;
    }

    .footer-links a:hover { color: var(--ink); }
  </style>

  <script>
    const API = 'https://poc-backend.amdal-dev.workers.dev/api/audit';

    const PACKAGES = [
      { name: 'axios', story: 'Token theft attack Mar 2026 through one publisher account. Socket caught it post-publish.' },
      { name: 'chalk', story: 'One publisher. Its account was phished in Sept 2025 and shipped a malicious 5.6.1. Current code is clean.' },
      { name: 'lodash', story: 'One npm publisher behind one of the largest install bases on npm.' },
      { name: 'express', story: 'Active multi-maintainer team. Healthy release cadence. Low structural risk.' },
      { name: 'esbuild', story: 'Single author. Outstanding software, one credential point of failure.' },
    ];

    type AuditResult = {
      name: string;
      score: number | null;
      maintainers: number | null;
      weeklyDownloads: number | null;
      ageYears: number | null;
      trend: string | null;
      riskFlags: string[];
    };

    function fmtDownloads(n: number | null): string {
      if (n === null || n === undefined) return '—';
      if (n >= 1_000_000_000) return (n / 1_000_000_000).toFixed(1) + 'B';
      if (n >= 1_000_000) return (n / 1_000_000).toFixed(0) + 'M';
      if (n >= 1_000) return (n / 1_000).toFixed(0) + 'K';
      return n.toString();
    }

    function scoreClass(score: number | null): string {
      if (score === null) return '';
      if (score >= 75) return 'score-high';
      if (score >= 50) return 'score-mid';
      return 'score-low';
    }

    function renderRow(pkg: typeof PACKAGES[0], data: AuditResult): string {
      const isCritical = data.riskFlags?.includes('CRITICAL');
      const riskBadge = isCritical
        ? '<span class="risk-badge risk-critical">CRITICAL</span>'
        : '<span class="risk-badge risk-ok">OK</span>';

      const dlDisplay = fmtDownloads(data.weeklyDownloads);

      const chips: string[] = [];
      if (data.maintainers !== null) {
        const cls = data.maintainers === 1 ? 'danger' : 'good';
        chips.push(`<span class="signal-chip ${cls}">${data.maintainers} maintainer${data.maintainers !== 1 ? 's' : ''}</span>`);
      }
      if (data.weeklyDownloads !== null) {
        const cls = data.weeklyDownloads > 10_000_000 ? 'danger' : '';
        chips.push(`<span class="signal-chip ${cls}">${dlDisplay}/wk</span>`);
      }
      if (data.ageYears !== null) {
        chips.push(`<span class="signal-chip">${data.ageYears}y old</span>`);
      }
      if (data.trend) {
        const cls = data.trend === 'growing' && isCritical ? 'warn' : '';
        chips.push(`<span class="signal-chip ${cls}">${data.trend}</span>`);
      }

      const commitCellClass = isCritical ? 'is-critical' : 'is-ok';

      return `
        <div class="compare-row">
          <div class="pkg-info">
            <span class="pkg-name">${pkg.name}</span>
            <span class="pkg-downloads">${dlDisplay}/wk</span>
          </div>
          <div class="compare-cell socket-cell">
            <div class="socket-ok-row">
              <span class="socket-ok-icon">✓</span>
              <span class="socket-ok-text">No malicious code detected</span>
            </div>
            <div class="commit-note">No suspicious patterns, network calls, or install scripts.</div>
          </div>
          <div class="compare-cell commit-cell ${commitCellClass}">
            <div class="commit-score-row">
              <span class="commit-score ${scoreClass(data.score)}">${data.score !== null ? data.score + '/100' : '—'}</span>
              ${riskBadge}
            </div>
            <div class="commit-signals">${chips.join('')}</div>
            <div class="commit-note">${pkg.story}</div>
          </div>
        </div>
      `;
    }

    async function loadData() {
      const loadingEl = document.getElementById('loading-state')!;
      const errorEl = document.getElementById('error-state')!;
      const rowsEl = document.getElementById('compare-rows')!;

      try {
        const res = await fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ packages: PACKAGES.map(p => p.name), ecosystem: 'npm' }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json() as { results: AuditResult[] };

        const byName: Record<string, AuditResult> = {};
        data.results.forEach(r => { byName[r.name] = r; });

        rowsEl.innerHTML = PACKAGES.map(pkg => {
          const result = byName[pkg.name];
          if (!result) return '';
          return renderRow(pkg, result);
        }).join('');

        loadingEl.hidden = true;
        rowsEl.hidden = false;
      } catch (err) {
        loadingEl.hidden = true;
        document.getElementById('error-msg')!.textContent =
          'Could not load live data: ' + (err instanceof Error ? err.message : String(err));
        errorEl.hidden = false;
        showFallback();
        rowsEl.hidden = false;
      }
    }

    function showFallback() {
      const fallback: AuditResult[] = [
        { name: 'axios', score: 89, maintainers: 1, weeklyDownloads: 100837905, ageYears: 11.6, trend: 'growing', riskFlags: ['CRITICAL'] },
        { name: 'chalk', score: 75, maintainers: 1, weeklyDownloads: 411150684, ageYears: 12.7, trend: 'stable', riskFlags: ['CRITICAL'] },
        { name: 'lodash', score: 87, maintainers: 1, weeklyDownloads: 145226382, ageYears: 14, trend: 'growing', riskFlags: ['CRITICAL'] },
        { name: 'express', score: 97, maintainers: 5, weeklyDownloads: 92917741, ageYears: 15.3, trend: 'growing', riskFlags: [] },
        { name: 'esbuild', score: 88, maintainers: 1, weeklyDownloads: 193690280, ageYears: 8.4, trend: 'growing', riskFlags: ['CRITICAL'] },
      ];

      const byName: Record<string, AuditResult> = {};
      fallback.forEach(r => { byName[r.name] = r; });

      const rowsEl = document.getElementById('compare-rows')!;
      rowsEl.innerHTML = PACKAGES.map(pkg => {
        const result = byName[pkg.name];
        if (!result) return '';
        return renderRow(pkg, result);
      }).join('');
    }

    loadData();
  </script>
</Layout>
