---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Commit API Reference — Developer Documentation"
  description="REST API reference for Commit. Audit npm and PyPI packages for supply chain risk, scan GitHub repos, build dependency graphs, and embed trust badges."
  canonical="https://getcommit.dev/docs/"
>
  <!-- Nav -->
  <nav>
    <div class="container nav-inner">
      <a href="/" class="nav-brand">Commit</a>
      <ul class="nav-links">
        <li><a href="/#mcp">MCP</a></li>
        <li><a href="/audit">Audit</a></li>
        <li><a href="/watchlist">Watchlist</a></li>
        <li><a href="/badges">Badges</a></li>
        <li><a href="/docs" class="nav-active">Docs</a></li>
        <li><a href="/blog">Writing</a></li>
        <li><a href="/pricing">Pricing</a></li><li><a href="/docs">Docs</a></li><li><a href="https://github.com/piiiico/proof-of-commitment" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </div>
  </nav>

  <!-- Header -->
  <section class="docs-header">
    <div class="container">
      <div class="editorial" style="max-width: var(--max-content); margin: 0 auto;">
        <div class="docs-version-badge">REST API · v1</div>
        <h1 class="docs-title">API <em>Reference</em></h1>
        <p class="docs-lead">
          Audit npm and PyPI packages for supply chain risk, scan GitHub repos,
          build dependency graphs, and embed trust badges — from your CI pipeline,
          scripts, or IDE.
        </p>
        <div class="base-url-box">
          <span class="base-url-label">Base URL</span>
          <code class="base-url-value">https://poc-backend.amdal-dev.workers.dev</code>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Quick Start -->
  <section class="docs-section">
    <div class="container">
      <div class="editorial" style="max-width: var(--max-content); margin: 0 auto;">
        <span class="docs-section-number">01</span>
        <h2 class="docs-section-title">Quick Start</h2>
        <p class="docs-intro">Audit a package in 30 seconds. No API key needed for single-package queries.</p>

        <div class="snippet-group">
          <div class="snippet-tab-row">
            <button class="snippet-tab active" data-group="qs" data-lang="curl">curl</button>
            <button class="snippet-tab" data-group="qs" data-lang="node">Node</button>
            <button class="snippet-tab" data-group="qs" data-lang="python">Python</button>
          </div>

          <div class="snippet-block" data-group="qs" data-lang="curl">
            <pre><code><span class="c-comment"># Audit a single npm package (free, no API key)</span>
curl -X POST https://poc-backend.amdal-dev.workers.dev/api/audit \
  -H "Content-Type: application/json" \
  -d '&#123;"packages": ["chalk"]&#125;'</code></pre>
          </div>

          <div class="snippet-block hidden" data-group="qs" data-lang="node">
            <pre><code><span class="c-comment">// Audit a single npm package (free, no API key)</span>
const res = await fetch(
  "https://poc-backend.amdal-dev.workers.dev/api/audit",
  &#123;
    method: "POST",
    headers: &#123; "Content-Type": "application/json" &#125;,
    body: JSON.stringify(&#123; packages: ["chalk"] &#125;),
  &#125;
);
const data = await res.json();
console.log(data.results[0]);</code></pre>
          </div>

          <div class="snippet-block hidden" data-group="qs" data-lang="python">
            <pre><code><span class="c-comment"># Audit a single npm package (free, no API key)</span>
import requests

resp = requests.post(
    "https://poc-backend.amdal-dev.workers.dev/api/audit",
    json=&#123;"packages": ["chalk"]&#125;,
)
print(resp.json()["results"][0])</code></pre>
          </div>
        </div>

        <div class="response-example">
          <span class="response-label">Response</span>
          <pre><code>&#123;
  "count": 1,
  "results": [
    &#123;
      "name": "chalk",
      "ecosystem": "npm",
      "score": 74,
      "maintainers": 1,
      "weeklyDownloads": 411000000,
      "ageYears": 12.3,
      "trend": "stable",
      "daysSinceLastPublish": 420,
      "riskFlags": ["CRITICAL"],
      "scoreBreakdown": &#123;
        "longevity": 25,
        "downloadMomentum": 25,
        "releaseConsistency": 14,
        "maintainerDepth": 4,
        "githubBacking": 6
      &#125;
    &#125;
  ]
&#125;</code></pre>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Authentication -->
  <section class="docs-section docs-section-alt">
    <div class="container">
      <div class="editorial" style="max-width: var(--max-content); margin: 0 auto;">
        <span class="docs-section-number">02</span>
        <h2 class="docs-section-title">Authentication</h2>
        <p class="docs-intro">
          All endpoints work without authentication. Free tier uses IP-based rate limiting.
          Any paid tier — starting at <strong>Developer ($15/mo)</strong> — issues an
          API key with higher limits, batch audits, and CI/CD automation.
        </p>

        <div class="auth-tiers">
          <div class="auth-tier">
            <div class="auth-tier-header">
              <span class="auth-tier-name">Free</span>
              <span class="auth-tier-desc">No setup required</span>
            </div>
            <p class="auth-tier-body">
              Requests are rate-limited per IP address. No header required.
              Single-package audit per request.
            </p>
          </div>
          <div class="auth-tier auth-tier-paid">
            <div class="auth-tier-header">
              <span class="auth-tier-name">Developer</span>
              <span class="auth-tier-badge">$15/mo</span>
            </div>
            <p class="auth-tier-body">
              Pass your API key as a Bearer token. Unlocks batch audits
              (up to 5 packages/request), 1,000 audits/day, dependency monitoring,
              and CI/CD auto-trigger.
            </p>
            <div class="auth-example">
              <code>Authorization: Bearer sk_commit_a3f9b2...</code>
            </div>
          </div>
          <div class="auth-tier">
            <div class="auth-tier-header">
              <span class="auth-tier-name">Pro</span>
              <span class="auth-tier-badge">$29/mo</span>
            </div>
            <p class="auth-tier-body">
              Everything in Developer, plus larger batches (up to 20 packages/request),
              10,000 audits/month, webhooks, and 10 monitored projects — flat fee per
              project, not per seat.
            </p>
          </div>
        </div>

        <div class="auth-key-format">
          <span class="auth-key-label">API key format</span>
          <code>sk_commit_</code> followed by 32 hex characters.
          Keys are issued after checkout at <a href="/pricing">getcommit.dev/pricing</a> —
          the cheapest tier with an API key is Developer at $15/mo.
          Store them securely — they are shown once.
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Rate Limits -->
  <section class="docs-section">
    <div class="container">
      <div class="editorial" style="max-width: var(--max-content); margin: 0 auto;">
        <span class="docs-section-number">03</span>
        <h2 class="docs-section-title">Rate Limits</h2>
        <p class="docs-intro">
          Rate limit headers are returned on every response:
          <code>X-RateLimit-Limit</code>, <code>X-RateLimit-Remaining</code>,
          <code>X-RateLimit-Reset</code>.
        </p>

        <div class="rate-table-wrapper">
          <table class="rate-table">
            <thead>
              <tr>
                <th>Endpoint</th>
                <th>Free</th>
                <th>Developer<br /><span class="rate-note">$15/mo</span></th>
                <th>Pro<br /><span class="rate-note">$29/mo</span></th>
                <th>Enterprise</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>POST /api/audit</code></td>
                <td>200 / day<br /><span class="rate-note">1 pkg/request</span></td>
                <td>1,000 / day<br /><span class="rate-note">5 pkgs/request</span></td>
                <td>10,000 / month<br /><span class="rate-note">20 pkgs/request</span></td>
                <td>Unlimited</td>
              </tr>
              <tr>
                <td><code>POST /api/audit/github</code></td>
                <td>10 / day</td>
                <td>200 / day</td>
                <td>500 / month</td>
                <td>Unlimited</td>
              </tr>
              <tr>
                <td><code>POST /api/graph/npm</code></td>
                <td>5 / day</td>
                <td>50 / day</td>
                <td>200 / month</td>
                <td>Unlimited</td>
              </tr>
              <tr>
                <td><code>GET /badge/npm/:pkg</code></td>
                <td colspan="4">Unlimited (24h CDN cache)</td>
              </tr>
              <tr>
                <td><code>GET /badge/pypi/:pkg</code></td>
                <td colspan="4">Unlimited (24h CDN cache)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="rate-reset-note">
          Free and Developer tiers reset daily at midnight UTC.
          Pro tier resets on the first day of each calendar month.
          When a limit is exceeded, the API returns <code>429 Too Many Requests</code>
          with a <code>Retry-After</code> header.
        </p>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Endpoints -->
  <section class="docs-section docs-section-alt">
    <div class="container">
      <div class="editorial" style="max-width: var(--max-content); margin: 0 auto;">
        <span class="docs-section-number">04</span>
        <h2 class="docs-section-title">Endpoints</h2>

        <!-- POST /api/audit -->
        <div class="endpoint">
          <div class="endpoint-header">
            <span class="method method-post">POST</span>
            <code class="endpoint-path">/api/audit</code>
          </div>
          <p class="endpoint-desc">
            Score npm or PyPI packages for supply chain risk.
            Results sorted by score ascending (highest risk first).
          </p>

          <h4 class="param-heading">Request body</h4>
          <table class="param-table">
            <thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
            <tbody>
              <tr>
                <td><code>packages</code></td>
                <td>string[]</td>
                <td>Yes</td>
                <td>Package names. Max 1 (free), 5 (Developer), 20 (Pro/Enterprise). Mix npm and PyPI names freely when ecosystem is "auto".</td>
              </tr>
              <tr>
                <td><code>ecosystem</code></td>
                <td>string</td>
                <td>No</td>
                <td><code>"npm"</code> | <code>"pypi"</code> | <code>"auto"</code> (default). Auto defaults to npm.</td>
              </tr>
            </tbody>
          </table>

          <div class="snippet-group">
            <div class="snippet-tab-row">
              <button class="snippet-tab active" data-group="audit" data-lang="curl">curl</button>
              <button class="snippet-tab" data-group="audit" data-lang="node">Node</button>
              <button class="snippet-tab" data-group="audit" data-lang="python">Python</button>
            </div>
            <div class="snippet-block" data-group="audit" data-lang="curl">
              <pre><code><span class="c-comment"># Batch audit — requires API key (Developer $15/mo or higher)</span>
curl -X POST https://poc-backend.amdal-dev.workers.dev/api/audit \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer sk_commit_..." \
  -d '&#123;
    "packages": ["axios", "lodash", "express", "chalk"],
    "ecosystem": "npm"
  &#125;'</code></pre>
            </div>
            <div class="snippet-block hidden" data-group="audit" data-lang="node">
              <pre><code>const res = await fetch(
  "https://poc-backend.amdal-dev.workers.dev/api/audit",
  &#123;
    method: "POST",
    headers: &#123;
      "Content-Type": "application/json",
      "Authorization": "Bearer sk_commit_...",
    &#125;,
    body: JSON.stringify(&#123;
      packages: ["axios", "lodash", "express", "chalk"],
      ecosystem: "npm",
    &#125;),
  &#125;
);
const &#123; results &#125; = await res.json();
const critical = results.filter(r => r.riskFlags.includes("CRITICAL"));
console.log("Critical packages:", critical.map(r => r.name));</code></pre>
            </div>
            <div class="snippet-block hidden" data-group="audit" data-lang="python">
              <pre><code>import requests

resp = requests.post(
    "https://poc-backend.amdal-dev.workers.dev/api/audit",
    headers=&#123;"Authorization": "Bearer sk_commit_..."&#125;,
    json=&#123;
        "packages": ["requests", "flask", "django"],
        "ecosystem": "pypi",
    &#125;,
)
data = resp.json()
for pkg in data["results"]:
    print(f"&#123;pkg['name']&#125;: &#123;pkg['score']&#125; &#123;pkg['riskFlags']&#125;")</code></pre>
            </div>
          </div>
        </div>

        <!-- POST /api/audit/github -->
        <div class="endpoint">
          <div class="endpoint-header">
            <span class="method method-post">POST</span>
            <code class="endpoint-path">/api/audit/github</code>
          </div>
          <p class="endpoint-desc">
            Fetch dependencies from a GitHub repository and run supply chain risk scoring.
            Reads <code>package.json</code> and <code>requirements.txt</code> automatically.
          </p>

          <h4 class="param-heading">Request body</h4>
          <table class="param-table">
            <thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
            <tbody>
              <tr>
                <td><code>repo</code></td>
                <td>string</td>
                <td>Yes</td>
                <td>GitHub repo as <code>"owner/repo"</code> or full URL. E.g. <code>"facebook/react"</code> or <code>"https://github.com/expressjs/express"</code>.</td>
              </tr>
            </tbody>
          </table>

          <div class="snippet-group">
            <div class="snippet-tab-row">
              <button class="snippet-tab active" data-group="gh" data-lang="curl">curl</button>
              <button class="snippet-tab" data-group="gh" data-lang="node">Node</button>
            </div>
            <div class="snippet-block" data-group="gh" data-lang="curl">
              <pre><code>curl -X POST https://poc-backend.amdal-dev.workers.dev/api/audit/github \
  -H "Content-Type: application/json" \
  -d '&#123;"repo": "vercel/next.js"&#125;'</code></pre>
            </div>
            <div class="snippet-block hidden" data-group="gh" data-lang="node">
              <pre><code>const res = await fetch(
  "https://poc-backend.amdal-dev.workers.dev/api/audit/github",
  &#123;
    method: "POST",
    headers: &#123; "Content-Type": "application/json" &#125;,
    body: JSON.stringify(&#123; repo: "vercel/next.js" &#125;),
  &#125;
);
const data = await res.json();
// data.repo, data.npmPackages, data.pypiPackages, data.results</code></pre>
            </div>
          </div>

          <div class="response-example">
            <span class="response-label">Response shape</span>
            <pre><code>&#123;
  "repo": "vercel/next.js",
  "npmPackages": 18,
  "pypiPackages": 0,
  "count": 18,
  "results": [ <span class="c-comment">/* same shape as /api/audit results */</span> ]
&#125;</code></pre>
          </div>
        </div>

        <!-- POST /api/graph/npm -->
        <div class="endpoint">
          <div class="endpoint-header">
            <span class="method method-post">POST</span>
            <code class="endpoint-path">/api/graph/npm</code>
          </div>
          <p class="endpoint-desc">
            Build a dependency risk graph for an npm package. Returns nodes (packages with scores)
            and edges (dependency relationships). <code>depth=2</code> traverses transitive dependencies
            of risky packages.
          </p>

          <h4 class="param-heading">Request body</h4>
          <table class="param-table">
            <thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
            <tbody>
              <tr>
                <td><code>package</code></td>
                <td>string</td>
                <td>Yes</td>
                <td>Root npm package name. E.g. <code>"express"</code>.</td>
              </tr>
              <tr>
                <td><code>depth</code></td>
                <td>1 | 2</td>
                <td>No</td>
                <td>Default 1 (root + direct deps). Depth 2 adds transitive deps of risky packages.</td>
              </tr>
            </tbody>
          </table>

          <div class="snippet-group">
            <div class="snippet-tab-row">
              <button class="snippet-tab active" data-group="graph" data-lang="curl">curl</button>
              <button class="snippet-tab" data-group="graph" data-lang="node">Node</button>
            </div>
            <div class="snippet-block" data-group="graph" data-lang="curl">
              <pre><code>curl -X POST https://poc-backend.amdal-dev.workers.dev/api/graph/npm \
  -H "Content-Type: application/json" \
  -d '&#123;"package": "express", "depth": 1&#125;'</code></pre>
            </div>
            <div class="snippet-block hidden" data-group="graph" data-lang="node">
              <pre><code>const res = await fetch(
  "https://poc-backend.amdal-dev.workers.dev/api/graph/npm",
  &#123;
    method: "POST",
    headers: &#123; "Content-Type": "application/json" &#125;,
    body: JSON.stringify(&#123; package: "express", depth: 1 &#125;),
  &#125;
);
const &#123; nodes, edges, summary &#125; = await res.json();
console.log(`&#123;summary.criticalCount&#125; CRITICAL packages in tree`);</code></pre>
            </div>
          </div>

          <div class="response-example">
            <span class="response-label">Response shape</span>
            <pre><code>&#123;
  "root": "express",
  "depth": 1,
  "nodes": [
    &#123;
      "name": "express",
      "score": 97,
      "maintainers": 5,
      "weeklyDownloads": 93000000,
      "ageYears": 15.2,
      "trend": "growing",
      "riskFlags": [],
      "depth": 0
    &#125;,
    <span class="c-comment">/* direct deps at depth: 1 */</span>
  ],
  "edges": [&#123; "from": "express", "to": "body-parser" &#125;, ...],
  "summary": &#123;
    "totalNodes": 12,
    "criticalCount": 0,
    "highCount": 1,
    "warnCount": 2,
    "worstScore": 42,
    "criticalTransitivePaths": []
  &#125;
&#125;</code></pre>
          </div>
        </div>

        <!-- Badges -->
        <div class="endpoint">
          <div class="endpoint-header">
            <span class="method method-get">GET</span>
            <code class="endpoint-path">/badge/npm/:package</code>
          </div>
          <div class="endpoint-header" style="margin-top: 0.5rem;">
            <span class="method method-get">GET</span>
            <code class="endpoint-path">/badge/pypi/:package</code>
          </div>
          <p class="endpoint-desc">
            Returns a shields.io-compatible SVG badge with the trust score.
            CDN-cached for 24 hours. Handles scoped npm packages: <code>/badge/npm/@scope/name</code>.
          </p>

          <div class="snippet-group">
            <div class="snippet-tab-row">
              <button class="snippet-tab active" data-group="badge" data-lang="markdown">Markdown</button>
              <button class="snippet-tab" data-group="badge" data-lang="html">HTML</button>
            </div>
            <div class="snippet-block" data-group="badge" data-lang="markdown">
              <pre><code><span class="c-comment"># Add to your README.md</span>
[![Commit Score](https://getcommit.dev/badge/npm/express)](https://getcommit.dev/scan/express)

[![Commit Score](https://getcommit.dev/badge/pypi/requests)](https://getcommit.dev)</code></pre>
            </div>
            <div class="snippet-block hidden" data-group="badge" data-lang="html">
              <pre><code>&lt;a href="https://getcommit.dev/scan/express"&gt;
  &lt;img src="https://getcommit.dev/badge/npm/express"
       alt="Commit Score" /&gt;
&lt;/a&gt;</code></pre>
            </div>
          </div>

          <div class="badge-colors-mini">
            <div class="badge-color-row">
              <span class="mini-badge" style="background:#222;color:#fff;">⚠ CRITICAL</span>
              <span class="mini-badge" style="background:#fe7d37;color:#fff;">&lt; 40 high risk</span>
              <span class="mini-badge" style="background:#dfb317;color:#fff;">40–59 moderate</span>
              <span class="mini-badge" style="background:#97ca00;color:#fff;">60–74 good</span>
              <span class="mini-badge" style="background:#44cc11;color:#fff;">75+ healthy</span>
              <span class="mini-badge" style="background:#9f9f9f;color:#fff;">not found</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Response Schema -->
  <section class="docs-section">
    <div class="container">
      <div class="editorial" style="max-width: var(--max-content); margin: 0 auto;">
        <span class="docs-section-number">05</span>
        <h2 class="docs-section-title">Response Schema</h2>
        <p class="docs-intro">Every package result from <code>/api/audit</code> and <code>/api/audit/github</code> has the same shape.</p>

        <table class="schema-table">
          <thead>
            <tr>
              <th>Field</th>
              <th>Type</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>name</code></td>
              <td>string</td>
              <td>Package name as returned by the registry.</td>
            </tr>
            <tr>
              <td><code>ecosystem</code></td>
              <td>"npm" | "pypi"</td>
              <td>Package registry.</td>
            </tr>
            <tr>
              <td><code>score</code></td>
              <td>number | null</td>
              <td>Trust score 0–100. <code>null</code> if package not found or error.</td>
            </tr>
            <tr>
              <td><code>maintainers</code></td>
              <td>number | null</td>
              <td>Number of publish-authorized maintainers.</td>
            </tr>
            <tr>
              <td><code>weeklyDownloads</code></td>
              <td>number | null</td>
              <td>Weekly download count (npm) or weekly equivalent for PyPI.</td>
            </tr>
            <tr>
              <td><code>ageYears</code></td>
              <td>number | null</td>
              <td>Package age in years, rounded to 1 decimal.</td>
            </tr>
            <tr>
              <td><code>trend</code></td>
              <td>"growing" | "stable" | "declining" | null</td>
              <td>90-day download trend. Growing if ratio &gt; 1.15, declining if &lt; 0.85.</td>
            </tr>
            <tr>
              <td><code>daysSinceLastPublish</code></td>
              <td>number | null</td>
              <td>Days since most recent version was published.</td>
            </tr>
            <tr>
              <td><code>riskFlags</code></td>
              <td>string[]</td>
              <td>
                <code>"CRITICAL"</code> — sole maintainer + &gt;10M downloads/wk.<br />
                <code>"HIGH"</code> — sole maintainer + &gt;1M, or &lt;1yr old + &gt;1M.<br />
                <code>"WARN"</code> — no publish in 365+ days.
              </td>
            </tr>
            <tr>
              <td><code>scoreBreakdown</code></td>
              <td>object | null</td>
              <td>
                Component scores per the <a href="/spec">scoring specification</a>:
                <code>longevity</code> (0–25),
                <code>downloadMomentum</code> (0–25),
                <code>releaseConsistency</code> (0–20),
                <code>maintainerDepth</code> (0–15),
                <code>githubBacking</code> (0–15).
              </td>
            </tr>
            <tr>
              <td><code>error</code></td>
              <td>string | undefined</td>
