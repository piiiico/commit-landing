---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Get your API key — Commit"
  description="Get a free Commit API key. 200 requests/day. No credit card required. Start auditing your supply chain in minutes."
  canonical="https://getcommit.dev/get-started/"
>
  <!-- Nav -->
  <nav>
    <div class="container nav-inner">
      <a href="/" class="nav-brand">Commit</a>
      <ul class="nav-links">
        <li><a href="/#mcp">MCP</a></li>
        <li><a href="/audit">Audit</a></li>
        <li><a href="/watchlist">Watchlist</a></li>
        <li><a href="/extension">Extension</a></li>
        <li><a href="/blog">Writing</a></li>
        <li><a href="/pricing">Pricing</a></li><li><a href="/docs">Docs</a></li>
        <li><a href="https://github.com/piiiico/proof-of-commitment" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="mailto:pico@amdal.dev">Contact</a></li>
      </ul>
    </div>
  </nav>

  <!-- Hero (ref-aware copy swap happens client-side — see script below) -->
  <section class="gs-hero">
    <div class="container">
      <div class="editorial" style="max-width: var(--max-content); margin: 0 auto;">
        <span class="hero-eyebrow" id="gs-hero-eyebrow">Get Started</span>
        <h1 class="gs-title" id="gs-hero-title">Get your API key</h1>
        <p class="gs-lead" id="gs-hero-lead">
          Free tier: 200 requests/day. No credit card required.<br />
          Your key appears on this page in seconds — no email round-trip.
        </p>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Key request form -->
  <section class="gs-form-section">
    <div class="container">
      <div class="gs-form-card reveal">
        <div id="gs-form-view">
          <h2 class="gs-form-heading">Start building with Commit</h2>
          <p class="gs-form-sub">Enter your email so we can bind usage to your account. Your key appears below the moment you submit.</p>
          <form id="gs-form" class="gs-form" novalidate>
            <div class="gs-input-row">
              <input
                id="gs-email"
                type="email"
                name="email"
                placeholder="you@company.com"
                autocomplete="email"
                required
                class="gs-input"
              />
              <button type="submit" id="gs-btn" class="gs-submit">Get API Key →</button>
            </div>
            <p id="gs-error" class="gs-feedback gs-error" hidden></p>
          </form>
          <p class="gs-privacy">
            Email binds usage to your account and serves as a backup for the key.
            No newsletter, no spam. See <a href="/privacy">privacy policy</a>.
          </p>
        </div>

        <div id="gs-success-view" hidden>
          <div class="gs-success-icon">✓</div>
          <h2 class="gs-success-heading" id="gs-success-title">Check your email</h2>
          <p class="gs-success-body" id="gs-success-body-text">
            Your API key is on its way to <strong id="gs-success-email"></strong>.
            It should arrive within a minute.
          </p>
          <div id="gs-key-display" hidden style="margin: 1rem 0; padding: 1rem; background: var(--bg-muted, #f5f5f5); border-radius: 8px; font-family: monospace; word-break: break-all; font-size: 0.95rem; border: 1px solid var(--border-light, #e0e0e0);"></div>
          <p id="gs-watching" class="gs-success-watching" hidden style="margin: 0.75rem 0; font-size: 0.95rem;"></p>
          <p class="gs-success-note" id="gs-success-note">
            Didn't get it? Check spam or <a href="mailto:pico@amdal.dev">contact us</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Quick-start -->
  <section class="qs-section">
    <div class="container">
      <div class="editorial reveal" style="max-width: var(--max-content); margin: 0 auto;">
        <span class="section-label">Quick start</span>
        <h2 class="section-heading">Start in 60 seconds</h2>
        <p class="qs-intro">
          Once you have your key, authenticate every request with the
          <code>Authorization</code> header.
        </p>

        <!-- cURL -->
        <div class="qs-block">
          <div class="qs-block-header">
            <span class="qs-lang">curl</span>
          </div>
          <pre class="qs-code"><code>curl https://poc-backend.amdal-dev.workers.dev/api/audit \
  -H "Authorization: Bearer sk_commit_YOUR_KEY_HERE" \
  -H "Content-Type: application/json" \
  -d '&#123;"packages":["axios"],"ecosystem":"npm"&#125;'</code></pre>
        </div>

        <!-- npm / Node.js -->
        <div class="qs-block">
          <div class="qs-block-header">
            <span class="qs-lang">Node.js</span>
          </div>
          <pre class="qs-code"><code>const res = await fetch(
  'https://poc-backend.amdal-dev.workers.dev/api/audit',
  &#123;
    method: 'POST',
    headers: &#123;
      'Authorization': 'Bearer sk_commit_YOUR_KEY_HERE',
      'Content-Type': 'application/json',
    &#125;,
    body: JSON.stringify(&#123; packages: ['axios'], ecosystem: 'npm' &#125;),
  &#125;
);
const data = await res.json();
console.log(data.results[0].score); // 0–100 trust score</code></pre>
        </div>

        <!-- GitHub Action -->
        <div class="qs-block">
          <div class="qs-block-header">
            <span class="qs-lang">GitHub Action</span>
          </div>
          <pre class="qs-code"><code>- name: Commit supply chain audit
  uses: actions/github-script@v7
  env:
    COMMIT_API_KEY: $&#123;&#123; secrets.COMMIT_API_KEY &#125;&#125;
  with:
    script: |
      const res = await fetch('https://poc-backend.amdal-dev.workers.dev/api/audit', &#123;
        method: 'POST',
        headers: &#123;
          'Authorization': `Bearer $&#123;process.env.COMMIT_API_KEY&#125;`,
          'Content-Type': 'application/json',
        &#125;,
        body: JSON.stringify(&#123; packages: ['lodash'], ecosystem: 'npm' &#125;),
      &#125;);
      const data = await res.json();
      const score = data.results[0].score;
      if (score &lt; 40) core.setFailed(`Low trust score: $&#123;score&#125;`);</code></pre>
        </div>

        <p class="qs-hint">
          Add <code>COMMIT_API_KEY</code> to your GitHub repository secrets under
          <strong>Settings → Secrets and variables → Actions</strong>.
          The free key gets 200 requests/day — enough for CI on most projects.
        </p>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Upgrade nudge -->
  <section class="upgrade-section">
    <div class="container">
      <div class="upgrade-card reveal">
        <div class="upgrade-text">
          <h2 class="upgrade-heading">Want more?</h2>
          <p class="upgrade-body">
            Developer ($15/mo) gives you 1,000 requests/day, batch up to 5 packages per call,
            and CI/CD workflows. Pro ($29/mo) adds 10,000 requests/month pooled, batch up to
            20 packages, dependency monitoring for 10 projects, and Slack/webhook alerts.
          </p>
        </div>
        <div class="upgrade-action">
          <!-- Buttons (not anchors) by design — handleUpgradeClick builds the
               checkout URL at click time with email pre-fill. Static anchors
               here caused crawlers to follow the link and create empty-email
               Stripe sessions on every crawl (caught 2026-06-07 ~05Z, 2 USD
               sessions). Worker-side no-email gate (worker.ts L6139, shipped
               2026-06-07 05:45Z) catches the residual, but per-IP rate-limit
               budget still gets consumed when crawlers hit the URL. This is
               the defense-in-depth layer: keep the URL out of indexable HTML
               entirely. See script block below for the click handler. -->
          <button type="button" class="upgrade-btn" data-tier="developer" data-utm-source="get-started" data-utm-campaign="upgrade-from-free-key">Upgrade to Developer — $15/mo →</button>
          <button type="button" class="upgrade-btn" data-tier="pro" data-utm-source="get-started" data-utm-campaign="upgrade-from-free-key" style="margin-top: 0.5rem; background: transparent; border: 1px solid var(--border); color: var(--ink);">Or Pro — $29/mo →</button>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Dashboard link -->
  <section class="dashboard-section">
    <div class="container">
      <div class="editorial reveal" style="max-width: var(--max-content); margin: 0 auto; text-align: center;">
        <h2 class="dash-heading">Track your usage</h2>
        <p class="dash-text">
          Have your key? Visit the dashboard to see requests used, your daily limit, and reset time.
        </p>
        <a href="/dashboard" class="btn-secondary">Open Dashboard →</a>
      </div>
    </div>
  </section>

  <footer>
    <div class="container footer-inner">
      <span class="footer-brand">Commit</span>
      <span class="footer-copy">Behavioral trust for the software supply chain.</span>
      <nav class="footer-links">
        <a href="/audit">Audit</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/pricing">Pricing</a>
        <a href="/blog">Writing</a>
        <a href="mailto:pico@amdal.dev">Contact</a>
      </nav>
    </div>
  </footer>

  <script>
    // Hero/sub copy is now static-inline because the backend always returns
    // the key in the JSON response when email delivery succeeds (worker.ts
    // /api/keys/create — formerly INLINE_KEY_SOURCES, removed 2026-05-23).
    // Email is the backup, not the gate. The 3-keys-per-IP-per-day limit
    // already prevents abuse, so the email round-trip provided zero
    // verification value and just added friction. The success-view JS below
    // handles inline display when `data.key` is present.

    // Ref-aware hero swap. When the user arrives from a CLI footer that
    // made a specific promise (e.g. "Lock in this baseline — get alerted
    // if any package degrades"), restate that promise on the destination
    // so the page doesn't look like the wrong page. Default (no ref or
    // unknown ref) keeps the original static copy — no regression for
    // direct visits or future ref tags. ABSORBS the orphaned CLI promise
    // into the destination; not a new feature, completes a broken chain.
    // Keep in sync with REF_TO_SOURCE below — every ref with a specific
    // promise in its source surface should have a HERO_BY_REF entry.
    (() => {
      const params = new URLSearchParams(window.location.search);
      const ref = params.get('ref') ?? '';
      // Sanitize optional ?pkg= for safe interpolation into innerHTML below.
      // Accept npm package shape only: scoped or unscoped, conservative charset.
      // Reject anything else (drops to generic pkg-profile copy — no XSS path).
      const pkgRaw = params.get('pkg') ?? '';
      const pkgName = /^@?[a-z0-9._/-]{1,100}$/i.test(pkgRaw) ? pkgRaw : '';
      const HERO_BY_REF: Record<string, { eyebrow: string; title: string; lead: string }> = {
        'audit-baseline': {
          eyebrow: 'Lock in your baseline',
          title: 'Save this scan as your reference point',
          lead:
            'Your scan came back clean. The free key lets you re-run this audit anytime, up to 200/day. Want push alerts the moment something degrades? Developer is $15/mo.',
        },
        'audit-cli-429': {
          eyebrow: 'Past the daily limit',
          title: 'Get a free key, keep scanning',
          lead:
            'Anonymous CLI is rate-limited. A free key bumps you to 200 audits/day — no card. Enter your email below; your key appears instantly on screen (email is just a backup).<br />' +
            'Then paste it back in your terminal as <code>export COMMIT_API_KEY=…</code> and re-run.',
        },
        'audit-web-429': {
          eyebrow: 'Past the daily limit',
          title: 'Get a free key, score the rest',
          lead:
            'You hit the shared anonymous quota on this network IP — likely corporate NAT or a dev container. A free key bumps you to 200 audits/day, no card. Enter your email below; your key appears instantly on screen.<br />' +
            'Then re-run your audit and paste the key as <code>Authorization: Bearer sk_commit_…</code> (or save it once with <code>npx proof-of-commitment login</code>).',
        },
        'cursor-hook-429': {
          eyebrow: 'Cursor hook hit the daily limit',
          title: 'Free key, full audits',
          lead:
            'The hook is doing its job. Today, the shared anonymous quota ran out and Commit started asking you to confirm before unscored packages run. A free key gives you 200 audits per day, bound to you, no card. Enter your email below; the key appears instantly.<br />' +
            'Save it with <code>npx proof-of-commitment login</code>. The hook re-arms on the next install.',
        },
        'claude-code-hook-429': {
          eyebrow: 'Claude Code hook hit the daily limit',
          title: 'Free key, full audits',
          lead:
            'The hook is doing its job. Today, the shared anonymous quota ran out and Commit started asking you to confirm before unscored packages run. A free key gives you 200 audits per day, bound to you, no card. Enter your email below; the key appears instantly.<br />' +
            'Save it with <code>npx proof-of-commitment login</code>. The hook re-arms on the next install.',
        },
        'poc-hook': {
          eyebrow: 'Hook installed',
          title: 'Bind it to you with a free key',
          lead:
            'The hook will audit every install going forward. Anonymous mode gives you 15 audits per day, shared across this network IP. A free key gives you 200 per day, bound to your account, no card. Enter your email below; the key appears instantly.<br />' +
            'Save it with <code>npx proof-of-commitment login</code>. The hook reads it automatically on the next install.',
        },
        'mcp-cli': {
          eyebrow: 'Free MCP quota filling up',
          title: 'Get alerted when packages you query get worse',
          lead:
            'A free key lifts the shared daily limit and sends push alerts if any package you\'ve queried degrades. No card. Enter your email; your key appears on screen.<br />' +
            'Then add <code>COMMIT_API_KEY: sk_commit_…</code> to the <code>env</code> block for this server in your Claude Desktop or Cursor MCP config.',
        },
        'audit-cli': {
          eyebrow: 'Free audit quota filling up',
          title: 'Get alerted when these scores change',
          lead:
            'A free key lifts the shared daily limit and pushes alerts if any package you audited degrades. No card. Enter your email; your key appears on screen.<br />' +
            'Then pass it in the same terminal: <code>export COMMIT_API_KEY=sk_commit_…</code>',
        },
        'audit-cli-soft-cta': {
          // Updated 2026-06-11 v1.29.2: CLI heading rephrased from quota-wall
          // ("past the free anonymous quota — lift to 200/day") to ongoing-
          // value ("auto-watch these for the next attack"). Watchlist
          // auto-seed shipped earlier today (abe53f1) made the value-shaped
          // proposition concrete: signup → packages from this scan on
          // watchlist + email if attacked. Hero echo must lead with the
          // same framing so declined-prompt → URL-copy → page does not
          // feel like the wrong page.
          eyebrow: 'Watch your packages for the next attack',
          title: 'Free email alerts when packages get attacked',
          lead:
            'A free key auto-seeds your watchlist from your CLI session and emails you when any of those packages get attacked or score lower. No card. Enter your email; your key appears on screen.<br />' +
            'Then save it: <code>npx proof-of-commitment login</code> or <code>export COMMIT_API_KEY=sk_commit_…</code>.',
        },
        // 2026-06-15: npm-package v1.32.0 (shipped 05:14Z) emits this ref for
        // the CRITICAL non-TTY upsell + the GitHub Actions PR-check annotation
        // — both call buildWatchUrl(results, 'cli-watch'). The reader is in a
        // CI log or piped output and clicked the Web link because the CRITICAL
        // packages were flagged with sole-publisher + >10M dl/wk shape. The
        // landing needs to lead with that finding, not the generic API-key
        // hero. Mirror structure of audit-web-critical (CRITICAL found, alert
        // promise) but adapted for the CI/non-TTY surface that emits the link.
        // Pairs with: REF_TO_SOURCE['cli-watch'] (attribution), CLI_SOURCES
        // (success-note), worker.ts CLI_SOURCES_WELCOME (welcome step 2).
        // The blind spot that hid this: scripts/check-funnel-surface-parity.ts
        // scans URL literals for ref=X but buildWatchUrl() passes the ref as
        // a function arg — extended in this same commit so the next CLI ship
        // cannot introduce another orphan ref unnoticed.
        // NOTE: comment must not contain unescaped apostrophes (e.g., "can't")
        // — deploy.ts GUARD 3 brace-walker (extractObjectKeys) treats them as
        // string delimiters and orphans every following HERO_BY_REF key.
        // Same bug class as the line-412 readme-monitoring comment note.
        'cli-watch': {
          eyebrow: 'CRITICAL packages found in your scan',
          title: 'Free email alerts the moment scores drop',
          lead:
            'Your CLI run flagged CRITICAL packages — sole npm publisher + >10M downloads/week — the structural shape behind every major supply-chain attack this year. ' +
            'A free key seeds your watchlist from this scan and emails you the moment any of those packages get attacked or score lower. 200 audits/day, no card.<br />' +
            'Want continuous monitoring across your whole tree? Developer ($15/mo) watches 15 packages with daily scans + push alerts.',
        },
        'cli': {
          eyebrow: 'From the CLI',
          title: 'Get a free key, keep auditing',
          lead:
            'A free key bumps you to 200 audits/day — no card. Enter your email; your key appears on screen.<br />' +
            'Save it in the same terminal: <code>export COMMIT_API_KEY=sk_commit_…</code> or run <code>npx proof-of-commitment login</code> to persist it.',
        },
        'audit-web': {
          eyebrow: 'From the audit tool',
          title: 'Run this in CI. Audit every push.',
          lead:
            'A free key bumps you to 200 audits/day — enough for every PR on every repo. Enter your email; your key appears on screen.<br />' +
            'Add <code>COMMIT_API_KEY</code> to your CI secrets and gate merges when a package drops below your threshold.',
        },
        'audit-web-critical': {
          eyebrow: 'Past the audit',
          title: 'Save this scan + get alerts',
          lead:
            'You just found CRITICAL packages. A free key saves the audit and notifies you when any of these score lower — daily re-scans, 200/day, no card.<br />' +
            'Want push alerts on every package change? Developer ($15/mo) watches your tree continuously.',
        },
        'audit-web-compromised': {
          // Added 2026-06-10 to match the audit-page CTA branch shipped in
          // audit.astro:1960 (compromisedCount > 0). Behavioral scores look
          // healthy today, but the same maintainer cluster / burst pattern
          // that hit them once will hit them again — pitch alert-on-next-
          // burst, not baseline lock-in. Without this entry the noscript
          // fallback landed on default hero copy and the previous reader
          // who saw "1 in confirmed supply-chain attack" found no echo of
          // that signal on the next page — momentum lost.
          eyebrow: 'Past the audit',
          title: 'Watch for the next burst',
          lead:
            'You just audited packages that were already caught in a confirmed supply-chain attack. ' +
            'They score healthy <em>today</em>, but the same maintainer cluster and burst pattern hits twice. ' +
            'A free key re-scans daily and emails you the moment a new coordinated burst hits any of them — 200 audits/day, no card.<br />' +
            'Want continuous monitoring across your full tree? Developer ($15/mo) watches every package and pages you within minutes.',
        },
        'audit-web-healthy': {
          eyebrow: 'Past the audit',
          title: 'Lock in this clean baseline',
          lead:
            'Your scan came back without CRITICAL flags — that\'s the baseline you want to defend. A free key re-runs this audit anytime, up to 200/day, no card.<br />' +
            'Want push alerts the moment a package degrades? Developer ($15/mo) sends them straight to email.',
        },
        'pkg-profile': pkgName
          ? {
              eyebrow: `From the ${pkgName} profile`,
              title: `Watch ${pkgName}. And the rest of your tree.`,
              lead:
                `A free key audits the other ~50 packages around <code>${pkgName}</code> — 200/day, no card.<br />` +
                `Want a heads-up when <code>${pkgName}</code>'s publisher count drops, its release cadence stalls, or its score degrades? Developer ($15/mo) adds push alerts on every package you watch.`,
            }
          : {
              eyebrow: 'From a package profile',
              title: 'Watch the packages you depend on',
              lead:
                'A free key audits 200 packages/day — your whole tree, not just the one you searched for.<br />' +
                'Want push alerts the moment a package you watch drops in score, loses publishers, or stalls? Developer ($15/mo) adds monitoring + email alerts.',
            },
        // 2026-06-12: ci-annotation shipped with npm-package v1.31.0 GitHub
        // Actions annotation work. The annotation surfaces in PR checks tab
        // when CI hits the anonymous rate limit; link points here as the
        // free-key landing. Without this entry the CI visitor lands on the
        // generic "Get your API key" hero — no echo of the PR-checks moment
        // they came from. CI is the highest-intent audience (already wired
        // Commit into a workflow); the copy needs to lead with "add the key
        // to repo secrets" not "enter your email." 5th occurrence of the
        // funnel-surface-gap pattern shipped with the npm release that
        // emits the ref. Symmetric ci-annotation handling lives in
        // pricing.astro (CONTEXT_BY_CAMPAIGN) for the paid-tier annotation
        // URL, and worker.ts VALID_SOURCES for attribution.
        'ci-annotation': {
          eyebrow: 'From your PR checks',
          title: 'Get a free key, unblock CI',
          lead:
            'Your GitHub Actions run hit the anonymous rate limit on this repo\'s IP. A free key bumps you to 200 audits/day — enough for every PR — no card. Enter your email below; the key appears instantly on screen.<br />' +
            'Then add it to repo secrets: <code>gh secret set COMMIT_API_KEY</code> (or paste in Settings → Secrets → Actions). Re-run the failed job and the annotation goes away.',
        },
        // 2026-06-13: README readers (GitHub + npm) had refs in their static
        // CTAs but neither were mapped here, in REF_TO_SOURCE, or in worker
        // VALID_SOURCES — both fell through to source=web, so the v1.31.1
        // visible-CRITICAL-demo README ship (same day, 02:43Z) was unmeasurable.
        // Splitting the two refs lets us measure GH-README vs npm-README
        // discovery separately: same package gets 670+ daily npm downloads
        // with 0 organic signups, so knowing which README the (eventual)
        // signup came from is the first measurable signal on a discovery
        // surface that has produced nothing in 92 days. Hero copy here picks
        // up the README promise (behavioral signals that cannot be faked)
        // and gives the next concrete step (run an audit on your own tree).
        // NOTE: comment must not contain single quotes — deploy.ts GUARD 3
        // brace-walker (extractObjectKeys) treats apostrophes as string
        // delimiters and skips the following keys when there is no closing
        // quote until end of body. Bug filed in deploy.ts but the comment-
        // free phrasing is the safer short-term workaround.
        'readme-monitoring': {
          eyebrow: 'From the GitHub README',
          title: 'Free monitoring on your supply chain',
          lead:
            'A free key gives you 200 audits/day across npm, PyPI, Cargo, and Go — no card. Enter your email; the key appears on screen.<br />' +
            'Then score your tree from the same terminal: <code>npx proof-of-commitment --file package-lock.json</code>. Developer ($15/mo) adds push alerts when any watched package degrades.',
        },
        'npm-readme-monitoring': {
          eyebrow: 'From the npm package page',
          title: 'Free monitoring on your supply chain',
          lead:
            'You already have the CLI installed (or one <code>npx</code> away). A free key bumps you to 200 audits/day — no card. Enter your email; the key appears on screen.<br />' +
            'Then score your tree: <code>npx proof-of-commitment --file package-lock.json</code>. Developer ($15/mo) adds push alerts when any watched package degrades.',
        },
        // 2026-06-14: Echo destination for /blog/snyk-scores-chalk-81 (top
        // organic blog at 15 visits/7d per first-party analytics). Lands the
        // reader who clicked a per-package watch CTA on the same question the
        // post asked — Snyk 81 vs Commit CRITICAL — rather than the generic
        // "Get your API key" hero that produces zero echo of what they just
        // read. Lead names the inbound package when /get-started?watch=<pkg>
        // is set so the CTA-to-page chain reads as one continuous answer.
        'blog-snyk-comparison': pkgName
          ? {
              eyebrow: `Watch ${pkgName}`,
              title: `Free alerts on ${pkgName}`,
              lead:
                `Snyk scores <code>${pkgName}</code> healthy. ` +
                `Commit watches the signal Snyk doesn't track — publisher concentration — and emails you when ${pkgName}'s publisher count drops, its release cadence stalls, or its score degrades.<br />` +
                `Free key, watchlist pre-seeded with <code>${pkgName}</code>, 200 audits/day for the rest of your tree. No card.`,
            }
          : {
              eyebrow: 'Past the Snyk score',
              title: 'Get the publisher signal Snyk misses',
              lead:
                'Snyk\'s Package Health Score rewards downloads, stars, and commit cadence. ' +
                'It doesn\'t score publisher concentration — the structural risk behind every major npm attack this year. ' +
                'A free key watches your packages for publisher-count drops, release-cadence stalls, and score degradation, and emails you the moment any of them changes. 200 audits/day, no card.<br />' +
                'Want continuous monitoring across your whole tree? Developer ($15/mo) watches 15 packages with daily scans.',
            },
      };
      // 2026-06-15: blog-<slug> fallback hero. Blog posts ship CTAs with
      // ref=blog-<slug> attribution; per-blog HERO_BY_REF entries (e.g.
      // blog-snyk-comparison) are kept for posts whose pitch needs custom
      // copy, but the discovery-watchlist promise is the same across most
      // hot-news posts. Without this fallback the reader from an AUR-1579
      // hot-news post (or any other blog-* ref without a specific entry)
      // lands on the generic "Get your API key" hero with no echo of the
      // finding the post just walked them through. 4th occurrence of the
      // "new discovery ref ships without HERO_BY_REF entry" pattern after
      // ci-annotation (2026-06-12), readme-monitoring + npm-readme-
      // monitoring (2026-06-13), and cli-watch (2026-06-15 05:48Z) — each
      // was fixed with a per-ref entry; this generalises to subtract the
      // gap class instead of adding entries forever. Pairs with the
      // parity-gate scan in check-funnel-surface-parity.ts that asserts
      // BLOG_HERO_FALLBACK exists whenever any blog-* ref is emitted from
      // commit-landing-v2/src/pages/blog/*.astro.
      // NOTE: comment must not contain unescaped apostrophes — deploy.ts
      // GUARD 3 brace-walker treats them as string delimiters and orphans
      // every following HERO_BY_REF key. See line-412 + line-336 warnings.
      const BLOG_SOURCE_RE = /^blog-[a-z0-9-]{1,40}$/;
      const BLOG_HERO_FALLBACK = {
        eyebrow: 'From the Commit blog',
        title: 'Watch these packages for the next attack',
        lead:
          'A free key seeds your watchlist with the packages flagged in this post and emails you the moment any of them get attacked or score lower. 200 audits/day, no card.<br />' +
          'Want continuous monitoring across your whole tree? Developer ($15/mo) watches 15 packages with daily scans + push alerts.',
      };
      const variant = HERO_BY_REF[ref] ?? (BLOG_SOURCE_RE.test(ref) ? BLOG_HERO_FALLBACK : undefined);
      if (!variant) return;
      const eyebrow = document.getElementById('gs-hero-eyebrow');
      const title = document.getElementById('gs-hero-title');
      const lead = document.getElementById('gs-hero-lead');
      if (eyebrow) eyebrow.textContent = variant.eyebrow;
      if (title) title.textContent = variant.title;
      if (lead) lead.innerHTML = variant.lead;
    })();

    const form = document.getElementById('gs-form') as HTMLFormElement | null;
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const emailInput = document.getElementById('gs-email') as HTMLInputElement;
        const submitBtn = document.getElementById('gs-btn') as HTMLButtonElement;
        const errorMsg = document.getElementById('gs-error') as HTMLParagraphElement;
        const email = emailInput.value.trim();

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          errorMsg.textContent = 'Please enter a valid email address.';
          errorMsg.hidden = false;
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
        errorMsg.hidden = true;

        // Funnel attribution: map URL ?ref=… to backend `source`.
        // Backend whitelist (worker.ts /api/keys/create): web | cli | api | mcp-soft-cta |
        // audit-cli-429 | audit-baseline | audit-web | audit-web-{critical,healthy,inline} |
        // web-pricing | pkg-profile.
        // Unknown refs are dropped so the backend records the default (web) — no
        // silent garbage in api_keys.source.
        const REF_TO_SOURCE: Record<string, string> = {
          'mcp-cli': 'mcp-soft-cta',                  // soft-CTA from MCP server (worker.ts MCP_SIGNUP_URL)
          'cli': 'cli',                                // inline CLI signup
          'audit-cli': 'cli',                          // audit soft-CTA (worker.ts AUDIT_SIGNUP_URL)
          'audit-cli-429': 'audit-cli-429',            // CLI 429 rescue (npm-package v1.17.0 + worker.ts hard-limit branch)
          'audit-web-429': 'audit-web-429',            // web /audit page 429 rescue (audit.astro renderRateLimitRescue) — 2026-06-01
          'audit-baseline': 'audit-baseline',          // CLI all-healthy footer soft CTA (npm-package v1.18.0) — 2026-05-24
          'audit-web': 'audit-web',                    // web /audit page secondary CTA (audit-waitlist-btn, no result yet)
          'audit-web-critical': 'audit-web-critical',  // post-result CTA on /audit when ≥1 CRITICAL — 2026-05-23
          'audit-web-healthy': 'audit-web-healthy',    // post-result CTA on /audit when 0 CRITICAL + ≥1 HIGH — 2026-05-23
          'audit-web-compromised': 'audit-web-compromised', // post-result CTA on /audit when ≥1 in compromised registry (Miasma, Mini Shai-Hulud, axios, TrapDoor, IronWorm, etc) — 2026-06-10
          'pkg-profile': 'pkg-profile',                // package profile pages (/npm/:pkg etc) Monitor CTA — 2026-05-23
          'cursor-hook-429': 'cursor-hook-429',        // Cursor IDE hook 429 deny/ask (npm-package v1.21.0+) — 2026-05-29
          'claude-code-hook-429': 'claude-code-hook-429', // Claude Code PreToolUse hook 429 (npm-package v1.22.0) — 2026-05-29
          'poc-hook': 'poc-hook',                      // Fresh `poc hook` install with no API key configured (npm-package v1.21.0+) — 2026-05-29
          'audit-cli-soft-cta': 'cli-soft-cta',        // CLI inline-prompt engagement-signal gate-bypass (npm-package v1.28.0+) — 2026-06-10
          'cli-watch': 'cli-watch',                    // CRITICAL non-TTY upsell + GH Actions PR-check annotation watchlist auto-seed (npm-package v1.32.0 buildWatchUrl) — 2026-06-15
          'ci-annotation': 'ci-annotation',            // GitHub Actions PR-checks rate-limit annotation (npm-package v1.31.0) — 2026-06-12
          'readme-monitoring': 'readme-monitoring',    // GitHub README CTA (proof-of-commitment/README.md) — 2026-06-13
          'npm-readme-monitoring': 'npm-readme-monitoring', // npm package-page README CTA (npm-package/README.md) — 2026-06-13
        };
        const params = new URLSearchParams(window.location.search);
        const refParam = params.get('ref') ?? '';
        const utmSource = params.get('utm_source') ?? '';
        // utm_source=cli comes from v1.14.0 static help-line CTA — map it the same way
        const UTM_TO_SOURCE: Record<string, string> = {
          'cli': 'cli',
        };
        // 2026-06-14: per-blog refs (blog-snyk-comparison, blog-stripe-gcs,
        // blog-drizzle-kit, …) pass through to the backend as-is. Backend
        // worker.ts /api/keys/create accepts /^blog-[a-z0-9-]{1,40}$/ via the
        // matching BLOG_REF_RE — pattern-admit replaces per-blog hardcoded
        // map entries (three were already leaking pre-this fix to source=web).
        // Charset + length match keeps analytics labels well-shaped; mirrors
        // backend regex.
        const BLOG_REF_RE = /^blog-[a-z0-9-]{1,40}$/;
        const blogSource = BLOG_REF_RE.test(refParam) ? refParam : undefined;
        const source = REF_TO_SOURCE[refParam] ?? blogSource ?? UTM_TO_SOURCE[utmSource];

        try {
          const body: { email: string; source?: string; watch?: Array<{ name: string; ecosystem: string }> } = { email };
          if (source) body.source = source;
          // 2026-06-12: package-profile path now actually watches the package
          // the user clicked. /npm/:pkg "Track this package" CTA promises
          // "Watch react. And the rest of your tree." — but pre-this commit
          // only the source ref was sent. The user's key was created, the
          // watchlist defaulted to empty/static, and the hero promise didn't
          // match what the welcome email or weekly digest delivered. The
          // /audit page already passes `watch` (shipped 2026-06-11 watchlist-
          // auto-seed); this closes the same gap on /get-started for the
          // ?ref=pkg-profile&pkg=<name>&eco=<ecosystem> entry-path. Backend
          // worker.ts /api/keys/create accepts body.watch and caps at
          // PACKAGE_LIMITS.free (3). pkgName is already sanitized at L249
          // against the same npm-name shape the backend allows; eco is
          // validated here against the same ECOSYSTEMS set the backend
          // checks (worker.ts ECOSYSTEMS = npm|pypi|cargo|golang).
          // pkgName scope: the IIFE that swaps hero copy declared its own
          // `pkgName` but in a sibling scope; re-derive here using the same
          // strict regex to avoid relying on cross-scope IIFE state.
          const pkgRawSubmit = params.get('pkg') ?? '';
          const pkgNameSubmit = /^@?[a-z0-9._/-]{1,100}$/i.test(pkgRawSubmit) ? pkgRawSubmit : '';
          if (refParam === 'pkg-profile' && pkgNameSubmit) {
            const rawEco = (params.get('eco') ?? 'npm').toLowerCase();
            const VALID_ECOS = new Set(['npm', 'pypi', 'cargo', 'golang']);
            const eco = VALID_ECOS.has(rawEco) ? rawEco : 'npm';
            body.watch = [{ name: pkgNameSubmit, ecosystem: eco }];
          }
          // 2026-06-14: generic `?watch=pkg1,pkg2,pkg3&eco=npm` multi-package URL
          // seeding. Closes the context-loss leak where any CTA pointing to
          // /get-started (e.g. /audit's bottom "Run this in CI?" button) lost
          // the scanned-packages context — user signed up, watchlist was empty,
          // welcome email + weekly digest were orthogonal to original intent.
          // Mirrors the pkg-profile single-pkg path above but for multi-pkg
          // callers. Safe to coexist: pkg-profile sets body.watch first; this
          // block only fills if pkg-profile didn't. Validation identical
          // (npm-name regex, ECOSYSTEMS set, free-tier cap of 3 — defense in
          // depth, backend also caps at PACKAGE_LIMITS.free).
          if (!body.watch) {
            const watchRawSubmit = params.get('watch') ?? '';
            if (watchRawSubmit) {
              const rawEcoMulti = (params.get('eco') ?? 'npm').toLowerCase();
              const VALID_ECOS_MULTI = new Set(['npm', 'pypi', 'cargo', 'golang']);
              const ecoMulti = VALID_ECOS_MULTI.has(rawEcoMulti) ? rawEcoMulti : 'npm';
              const names = watchRawSubmit
                .split(',')
                .map(n => n.trim())
                .filter(n => /^@?[a-z0-9._/-]{1,100}$/i.test(n))
                .slice(0, 3);
              if (names.length > 0) {
                body.watch = names.map(name => ({ name, ecosystem: ecoMulti }));
              }
            }
          }
          const res = await fetch('https://poc-backend.amdal-dev.workers.dev/api/keys/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });

          if (res.ok || res.status === 201) {
            const data = await res.json() as any;
            // Show success view
            const formView = document.getElementById('gs-form-view') as HTMLElement;
            const successView = document.getElementById('gs-success-view') as HTMLElement;
            const successEmail = document.getElementById('gs-success-email') as HTMLElement;
            formView.hidden = true;
            successView.hidden = false;
            successEmail.textContent = email;

            // If the API returned the key directly (email unavailable), show it
            if (data?.key) {
              const titleEl = document.getElementById('gs-success-title') as HTMLElement;
              const bodyEl = document.getElementById('gs-success-body-text') as HTMLElement;
              const keyDisplay = document.getElementById('gs-key-display') as HTMLElement;
              const noteEl = document.getElementById('gs-success-note') as HTMLElement;
              titleEl.textContent = 'Your API key';
              bodyEl.innerHTML = '<strong>Save this key now</strong> — it won\'t be shown again.';
              keyDisplay.textContent = data.key;
              keyDisplay.hidden = false;
              // Source-specific next step. CLI sources just hit the 429 wall (or the
              // help-line static CTA) — they're in a terminal and need to re-run the
              // command. Showing them an `Authorization: Bearer` REST snippet adds
              // friction (they have to translate it back to CLI usage). Web/API users
              // get the standard REST instruction.
              // 2026-06-12 (ci-annotation): CI engineers arriving from PR check
              // annotations need GitHub Secrets advice, not export/REST. Hero
              // copy promised `gh secret set COMMIT_API_KEY` + re-run — success
              // note now matches so the chain doesn't pivot mid-action. Pairs
              // with worker.ts welcome-email step 2 (same source-aware fork).
              // windsurf-hook-429 added to HOOK_SOURCES — VALID_SOURCES on the
              // worker has it but this set didn't, so windsurf signups got the
              // generic REST snippet instead of `poc login`. Same gap class.
              const CLI_SOURCES = new Set(['audit-cli-429', 'audit-baseline', 'cli', 'audit-cli', 'cli-soft-cta', 'cli-watch']);
              const HOOK_SOURCES = new Set(['cursor-hook-429', 'claude-code-hook-429', 'windsurf-hook-429', 'poc-hook']);
              const MCP_SOURCES = new Set(['mcp-soft-cta']);
              const CI_SOURCES = new Set(['ci-annotation']);
              // 2026-06-13 (readme-monitoring/npm-readme-monitoring): README readers
              // came for the monitoring promise. Hero says "score your tree" + "alerts
              // when any watched package degrades", so success-note must point at the
              // CLI login + audit flow (matches hero), not the generic Authorization:
              // Bearer REST snippet (which is for /api/audit consumers). Same surface
              // parity fix as ci-annotation: hero + success-note + welcome step 2 all
              // agree on the next action.
              const README_SOURCES = new Set(['readme-monitoring', 'npm-readme-monitoring']);
              // 2026-06-15: blog-<slug> sources (e.g. blog-aur-1579, blog-redhat-miasma,
              // blog-snyk-comparison) share intent with README sources: discovery
              // channel, "expand my coverage" mindset, and most have already pre-seeded
              // a watchlist via ?watch=… so step 1 (gs-watching) confirms what they're
              // watching. The generic "Authorization: Bearer" default contradicts that
              // by handing them a REST snippet they didn't ask for. Route blog-* through
              // the same login+score path. Mirrors worker.ts welcome-email step 2.
              const BLOG_SOURCE_RE = /^blog-[a-z0-9-]{1,40}$/;
              const isDiscoverySource = (s: string) =>
                README_SOURCES.has(s) || BLOG_SOURCE_RE.test(s);
              if (source && HOOK_SOURCES.has(source)) {
                // Hook users have the proof-of-commitment package already (it wrote the hook script).
                // `poc login <key>` writes to ~/.commit/config which all hook paths read via readApiKey().
                // That's persistent across terminals, unlike export COMMIT_API_KEY which only binds the
                // current shell — wrong scope for an IDE hook fired by any future terminal session.
                noteEl.innerHTML =
                  'Run this once. The hook reads <code style="background:var(--bg-muted,#f5f5f5);padding:0.1rem 0.3rem;border-radius:3px;">~/.commit/config</code> on every install:<br>' +
                  '<code style="display:inline-block;margin-top:0.4rem;padding:0.3rem 0.5rem;background:var(--bg-muted,#f5f5f5);border-radius:4px;font-size:0.85rem;">' +
                  'npx proof-of-commitment login ' + data.key +
                  '</code>';
              } else if (source && MCP_SOURCES.has(source)) {
                // MCP users arrived from the MCP server's soft-CTA. They need to add
                // the key to their Claude Desktop / Cursor MCP config, not set an env
                // var in a terminal. The env block is the right insertion point.
                noteEl.innerHTML =
                  'Add this to the <code style="background:var(--bg-muted,#f5f5f5);padding:0.1rem 0.3rem;border-radius:3px;">env</code> block for this server in your Claude Desktop or Cursor MCP config:<br>' +
                  '<code style="display:inline-block;margin-top:0.4rem;padding:0.3rem 0.5rem;background:var(--bg-muted,#f5f5f5);border-radius:4px;font-size:0.85rem;">' +
                  '"COMMIT_API_KEY": "' + data.key + '"' +
                  '</code>';
              } else if (source && CLI_SOURCES.has(source)) {
                noteEl.innerHTML =
                  'Run this in the same terminal to re-try with your key:<br>' +
                  '<code style="display:inline-block;margin-top:0.4rem;padding:0.3rem 0.5rem;background:var(--bg-muted,#f5f5f5);border-radius:4px;font-size:0.85rem;">' +
                  'export COMMIT_API_KEY=' + data.key +
                  '</code>';
              } else if (source && CI_SOURCES.has(source)) {
                // CI engineers came from a PR check annotation that fired when
                // their workflow hit the anonymous rate limit on this repo's
                // IP. They already have Commit wired into their CI — they just
                // need to bind the key. Telling them to copy `Authorization:
                // Bearer` makes them translate the snippet back to a GitHub
                // Actions step they already have. The right call-to-action is
                // the one the hero promised: `gh secret set COMMIT_API_KEY`,
                // then re-run the failed job.
                noteEl.innerHTML =
                  'Add it to your repo secrets so CI can use it. Run once locally:<br>' +
                  '<code style="display:inline-block;margin-top:0.4rem;padding:0.3rem 0.5rem;background:var(--bg-muted,#f5f5f5);border-radius:4px;font-size:0.85rem;word-break:break-all;">' +
                  'gh secret set COMMIT_API_KEY --body ' + data.key +
                  '</code><br>' +
                  '<span style="display:inline-block;margin-top:0.5rem;font-size:0.9rem;">(or paste in <strong>Settings → Secrets and variables → Actions</strong>). Re-run the failed job and the annotation goes away.</span>';
              } else if (source && isDiscoverySource(source)) {
                // README readers came for the monitoring pitch — get them onto
                // login + audit immediately. The hero says "score your tree" /
                // "Developer adds push alerts when any watched package degrades."
                // Step here = the same `poc login` + `--file package-lock.json`
                // path the welcome email's step 2 echoes, so the chain doesn't
                // pivot to REST/Bearer mid-flow.
                noteEl.innerHTML =
                  'Save the key, then score your tree from the same terminal:<br>' +
                  '<code style="display:inline-block;margin-top:0.4rem;padding:0.3rem 0.5rem;background:var(--bg-muted,#f5f5f5);border-radius:4px;font-size:0.85rem;word-break:break-all;">' +
                  'npx proof-of-commitment login ' + data.key +
                  '</code><br>' +
                  '<code style="display:inline-block;margin-top:0.3rem;padding:0.3rem 0.5rem;background:var(--bg-muted,#f5f5f5);border-radius:4px;font-size:0.85rem;">' +
                  'npx proof-of-commitment --file package-lock.json' +
                  '</code><br>' +
                  '<span style="display:inline-block;margin-top:0.5rem;font-size:0.9rem;">200 audits/day free. <strong>Developer ($15/mo)</strong> adds push alerts when any watched package degrades.</span>';
              } else {
                noteEl.textContent = 'Copy this key and use it in your requests as: Authorization: Bearer ' + data.key;
              }
            }

            // 2026-06-12: echo what we just put on the user's watchlist.
            // Closes the hero-promise gap on the pkg-profile path: hero says
            // "Watch react." — success state now confirms "Now watching:
            // react (npm)." Mirrors the audit-page renderInlineForm success
            // state which already shows the seeded list. Without this echo
            // the user sees "Check your email" but has no immediate proof
            // the click-from-package-page actually started watching that
            // package — they have to wait for the welcome email step 1 to
            // find out, by which point a meaningful share of signups have
            // already bounced before reading email.
            const watched: Array<{ name: string; ecosystem: string }> = Array.isArray(data?.watched_packages) ? data.watched_packages : [];
            if (watched.length > 0) {
              const watchEl = document.getElementById('gs-watching') as HTMLElement | null;
              if (watchEl) {
                const names = watched.map((w) => `<code style="background:var(--bg-muted,#f5f5f5);padding:0.1rem 0.3rem;border-radius:3px;">${w.name}</code>`).join(', ');
                const plural = watched.length === 1 ? 'package' : 'packages';
                watchEl.innerHTML = `✓ Now watching ${watched.length} ${plural}: ${names}. We'll email you the moment any of them gets attacked or drops in score.`;
                watchEl.hidden = false;
              }
            }

            // Email is now read live at upgrade-click time via the global
            // handleUpgradeClick handler (see end-of-script). After free-key
            // creation, #gs-email still holds the value the user typed, so
            // the click handler picks it up and assembles /api/checkout?
            // tier=…&email=… at navigation time. No href mutation needed.
            // Critical for webhook binding: checkout.session.completed uses
            // session.customer_details.email to provision the paid key —
            // mismatched emails would orphan the free key under a different
            // identity. Live-read keeps the upgrade email = signup email.
          } else {
            const data = await res.json() as any;
            const msg = data?.error ?? data?.message ?? `Error ${res.status} — please try again.`;
            throw new Error(msg);
          }
        } catch (err) {
          errorMsg.textContent = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
          errorMsg.hidden = false;
          submitBtn.disabled = false;
          submitBtn.textContent = 'Get API Key →';
        }
      });
    }

    // ── Upgrade button click handler ──────────────────────────────────────
    // Pairs with /api/checkout no-email gate (worker.ts L6139). The buttons
    // carry data-tier + data-utm-* but NO href — keeps the URL out of
    // crawler-indexable HTML. Click handler reads #gs-email live, builds the
    // /api/checkout URL with email pre-fill, and navigates. If the user
    // clicks before entering email, we scroll them to the form input and
    // surface a gentle prompt instead of triggering an empty checkout.
    function handleUpgradeClick(this: HTMLButtonElement, ev: MouseEvent) {
      ev.preventDefault();
      const btn = this;
      const tier = btn.dataset.tier ?? '';
      if (!tier) return;
      const emailInput = document.getElementById('gs-email') as HTMLInputElement | null;
      const rawEmail = emailInput?.value?.trim() ?? '';
      const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(rawEmail);
      if (!emailValid) {
        // No valid email yet — scroll to form and prompt. Stops empty-email
        // upgrades from reaching the worker's gate at all (saves the 302 +
        // rate-limit bump).
        emailInput?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        emailInput?.focus();
        const err = document.getElementById('gs-error');
        if (err) {
          err.textContent = 'Enter your email above to upgrade — your key is bound to this address.';
          err.hidden = false;
        }
        return;
      }
      const params = new URLSearchParams({ tier, email: rawEmail });
      const utmSource = btn.dataset.utmSource;
      const utmCampaign = btn.dataset.utmCampaign;
      if (utmSource) params.set('utm_source', utmSource);
      if (utmCampaign) params.set('utm_campaign', utmCampaign);
      window.location.href = '/api/checkout?' + params.toString();
    }
    document.querySelectorAll<HTMLButtonElement>('.upgrade-btn').forEach((btn) => {
      btn.addEventListener('click', handleUpgradeClick);
    });
  </script>

