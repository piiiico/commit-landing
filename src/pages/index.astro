    .demo-score-fill.mid  { background: #8a6d00; }
    .demo-score-fill.low  { background: var(--accent); }
  </style>

  <script lang="ts">
    const API = 'https://poc-backend.amdal-dev.workers.dev';

    function scoreClass(n: number): string {
      if (n >= 70) return 'high';
      if (n >= 45) return 'mid';
      return 'low';
    }

    function fmt(n: number): string {
      if (n >= 1_000_000_000) return (n / 1_000_000_000).toFixed(1) + 'B';
      if (n >= 1_000_000)     return (n / 1_000_000).toFixed(1) + 'M';
      if (n >= 1_000)         return (n / 1_000).toFixed(0) + 'K';
      return String(n);
    }

    function renderResult(biz: any) {
      const s = biz.signals;
      const f = biz.financials;
      const overallClass = scoreClass(s.overall);

      let financialRow = '';
      if (f) {
        financialRow = `
          <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-light); display: flex; gap: 2rem; flex-wrap: wrap;">
            <div>
              <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-subtle);">Revenue</div>
              <div style="font-size: 1rem; font-weight: 500; color: var(--ink);">${fmt(f.revenue)} NOK</div>
            </div>
            <div>
              <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-subtle);">Profit margin</div>
              <div style="font-size: 1rem; font-weight: 500; color: var(--ink);">${f.profitMargin}%</div>
            </div>
            <div>
              <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-subtle);">Equity ratio</div>
              <div style="font-size: 1rem; font-weight: 500; color: var(--ink); ${f.equityRatio < 0 ? 'color: var(--accent)' : ''}">${f.equityRatio}%</div>
            </div>
          </div>`;
      }

      return `
        <div class="demo-result-card">
          <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
            <div>
              <div style="font-family: var(--font-display); font-size: 1.35rem; color: var(--ink); line-height: 1.2;">${biz.name}</div>
              <div style="font-size: 0.8rem; color: var(--ink-subtle); margin-top: 0.25rem;">${biz.orgForm} · ${biz.location} · ${biz.industry}</div>
            </div>
            <div style="text-align: right; flex-shrink: 0;">
              <div style="font-size: 2.5rem; font-weight: 600; color: var(--ink); line-height: 1;">${s.overall}</div>
              <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-subtle);">Foundation score</div>
            </div>
          </div>

          <div style="display: grid; gap: 0.75rem;">
            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--ink-muted);">
                <span>Longevity <span style="color: var(--ink-subtle);">${Math.round(biz.yearsOperating)} years operating</span></span>
                <span style="font-weight: 500; color: var(--ink);">${s.temporal}</span>
              </div>
              <div class="demo-score-bar"><div class="demo-score-fill ${scoreClass(s.temporal)}" style="width: ${s.temporal}%"></div></div>
            </div>
            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--ink-muted);">
                <span>Financial health <span style="color: var(--ink-subtle);">${biz.employees ? biz.employees + ' employees' : ''}</span></span>
                <span style="font-weight: 500; color: var(--ink);">${s.financial}</span>
              </div>
              <div class="demo-score-bar"><div class="demo-score-fill ${scoreClass(s.financial)}" style="width: ${s.financial}%"></div></div>
            </div>
            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--ink-muted);">
                <span>Operational activity</span>
                <span style="font-weight: 500; color: var(--ink);">${s.operational}</span>
              </div>
              <div class="demo-score-bar"><div class="demo-score-fill ${scoreClass(s.operational)}" style="width: ${s.operational}%"></div></div>
            </div>
          </div>
          ${financialRow}
          <div style="margin-top: 1rem; font-size: 0.75rem; color: var(--ink-subtle);">
            Source: Brønnøysundregistrene · ${biz.isBankrupt ? '⚠️ Bankrupt' : biz.isActive ? '✓ Active' : 'Inactive'} · <span style="font-style: italic;">Behavioral layer in development</span>
          </div>
        </div>`;
    }

    async function lookup(query: string) {
      const input = document.getElementById('demo-input') as HTMLInputElement;
      const result = document.getElementById('demo-result')!;
      const loading = document.getElementById('demo-loading')!;
      const error = document.getElementById('demo-error')!;

      input.value = query;
      result.style.display = 'none';
      error.style.display = 'none';
      loading.style.display = 'block';

      try {
        const res = await fetch(`${API}/api/business/search?q=${encodeURIComponent(query)}`);
        const data = await res.json() as any;
        loading.style.display = 'none';

        if (!data.results || data.results.length === 0) {
          error.textContent = `No results found for "${query}". Try a different name.`;
          error.style.display = 'block';
          return;
        }

        result.innerHTML = renderResult(data.results[0]);
        result.style.display = 'block';
      } catch (e) {
        loading.style.display = 'none';
        error.textContent = 'Lookup failed. The API may be unavailable.';
        error.style.display = 'block';
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      // Pills
      document.querySelectorAll('.demo-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          const q = (pill as HTMLElement).dataset.query!;
          lookup(q);
        });
      });

      // Search button
      document.getElementById('demo-search-btn')!.addEventListener('click', () => {
        const input = document.getElementById('demo-input') as HTMLInputElement;
        const q = input.value.trim();
        if (q) lookup(q);
      });

      // Enter key
      document.getElementById('demo-input')!.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter') {
          const input = e.target as HTMLInputElement;
          const q = input.value.trim();
          if (q) lookup(q);
        }
      });

      // Auto-load Maaemo as the default example
      lookup('Maaemo');
    });
  </script>

