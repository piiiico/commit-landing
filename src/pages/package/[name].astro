<script>
  // Copy-link button: uses Clipboard API with a textarea fallback for older browsers.
  // Visual feedback via .copied class (green border + label swap), reverts after 1.5s.
  document.querySelectorAll<HTMLButtonElement>('.share-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-share-url');
      if (!url) return;
      const original = btn.textContent;
      const restore = () => {
        btn.textContent = original;
        btn.classList.remove('copied');
      };
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(url);
        } else {
          const ta = document.createElement('textarea');
          ta.value = url;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
        btn.textContent = 'Copied';
        btn.classList.add('copied');
        setTimeout(restore, 1500);
      } catch {
        btn.textContent = 'Copy failed';
        setTimeout(restore, 1500);
      }
    });
  });
</script>
