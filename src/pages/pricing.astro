    .attack-card {
      background: var(--paper-dim, #faf9f4);
      border: 1px solid var(--border, #e5e0d5);
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
    }

    .attack-date {
      display: block;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
