      flex-shrink: 0;
      margin-top: 0.15rem;
    }

    .feature-item code {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      background: var(--surface);
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      color: var(--ink);
