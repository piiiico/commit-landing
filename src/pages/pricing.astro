    .attack-desc {
      font-size: 0.85rem;
      line-height: 1.5;
      color: var(--ink-muted, #666);
      margin: 0;
    }

    .attack-bottom-line {
      max-width: var(--max-content, 52rem);
      margin: 1.5rem auto 0;
      text-align: center;
      font-size: 0.9rem;
      color: var(--ink-muted, #666);
      line-height: 1.6;
    }

    .attack-bottom-line code {
      background: var(--paper-dim, #faf9f4);
      padding: 0.15em 0.4em;
