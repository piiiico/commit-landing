    .checkout-modal-input:focus { border-color: var(--accent); }

    .checkout-modal-error {
      font-size: 0.8rem;
      color: var(--accent);
      margin: 0 0 0.75rem;
    }

    .checkout-modal-submit {
      display: block;
      width: 100%;
      padding: 0.85rem 1.5rem;
      background: var(--accent);
      color: white;
      border: none;
      border-radius: 4px;
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s;
      margin-top: 0.25rem;
