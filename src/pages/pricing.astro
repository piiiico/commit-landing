    .waitlist-submit:hover { background: var(--accent-dim); }
    .waitlist-submit:disabled { opacity: 0.65; cursor: default; }

    .waitlist-cta-link {
      display: inline-block;
      margin-top: 1rem;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--accent);
      text-decoration: none;
    }

    .waitlist-cta-link:hover { text-decoration: underline; }

    .waitlist-form-area { flex: 1; }

    .waitlist-divider-text {
      font-size: 0.8rem;
      color: var(--ink-subtle);
      margin: 0.75rem 0;
      text-align: center;
    }

    .waitlist-getkey-btn {
      display: inline-block;
      padding: 0.65rem 1.25rem;
      background: var(--paper);
      color: var(--accent);
      border: 1px solid var(--accent);
      border-radius: 4px;
      font-size: 0.875rem;
      font-weight: 500;
      text-decoration: none;
      transition: background 0.15s;
    }

    .waitlist-getkey-btn:hover {
      background: #fff8f5;
    }

    .waitlist-feedback {
      margin: 0.75rem 0 0;
      font-size: 0.875rem;
      line-height: 1.5;
    }

    .waitlist-success { color: #166534; }
    .waitlist-error   { color: var(--accent); }

    .waitlist-success-title {
      margin: 0 0 0.5rem;
      font-weight: 600;
    }

    .waitlist-key-display {
      display: block;
      padding: 0.6rem 0.75rem;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 4px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.875rem;
      color: #166534;
      word-break: break-all;
      user-select: all;
      margin: 0 0 0.5rem;
    }

    .waitlist-success-note {
      margin: 0 0 0.4rem;
      font-size: 0.8rem;
      color: var(--ink-muted);
    }

    .waitlist-inline-code {
      padding: 0.05rem 0.3rem;
      background: var(--bg-muted, #f5f5f5);
      border-radius: 3px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.8rem;
    }

    .waitlist-success-backup {
      margin: 0;
      font-size: 0.75rem;
      color: var(--ink-subtle);
