  <script>
    // ── Social-proof banner (populated from /api/stats/teams-protected) ──
    // Suppressed if count < 5 (handled server-side in the endpoint: period="none").
    (async () => {
      try {
        const resp = await fetch('https://poc-backend.amdal-dev.workers.dev/api/stats/teams-protected');
        if (!resp.ok) return;
        const data = await resp.json() as { ok?: boolean; count?: number; period?: string };
        if (!data.ok || !data.count || !data.period || data.period === 'none') return;
        const banner = document.getElementById('social-proof');
        const text = document.getElementById('social-proof-text');
        if (!banner || !text) return;
        const periodLabel: Record<string, string> = {
          '7d': 'this week',
          '30d': 'this month',
          'total': 'so far',
        };
        const label = periodLabel[data.period] ?? 'recently';
        text.textContent = `${data.count} teams started using Commit ${label}.`;
        banner.hidden = false;
      } catch {
        // Silent fail — social proof is non-critical.
      }
    })();

    // ── Checkout email modal ──
    const modal = document.getElementById('checkout-modal') as HTMLDivElement | null;
    const modalOverlay = modal?.querySelector('.checkout-modal-overlay');
    const modalClose = document.getElementById('checkout-modal-close') as HTMLButtonElement | null;
    const emailForm = document.getElementById('checkout-email-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('checkout-email') as HTMLInputElement | null;
    const emailError = document.getElementById('checkout-email-error') as HTMLParagraphElement | null;
    const submitBtn = document.getElementById('checkout-submit-btn') as HTMLButtonElement | null;
    let pendingTier = '';

    // ── UTM attribution capture (closes /pricing → /api/checkout-intent gap) ──
    // CLI funnel sends ?utm_source=cli&utm_campaign=watch-cmd (v1.18.2). Before
    // this, the API POST stripped UTMs at the body boundary, so paid Developer
    // conversions weren't attributable to the funnel. We now snapshot UTMs at
    // page load (URL is the canonical source — survives modal close/reopen)
    // and forward them into both POST checkout-intent + GET checkout fallback.
    const captureUtmSnapshot = (): {
      utm_source?: string; utm_medium?: string; utm_campaign?: string;
      utm_content?: string; utm_term?: string; referrer?: string;
    } => {
      try {
        const sp = new URLSearchParams(window.location.search);
        const out: Record<string, string> = {};
        for (const k of ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'] as const) {
          const v = sp.get(k);
          if (v && v.length > 0 && v.length < 200) out[k] = v;
        }
        if (document.referrer && document.referrer.length > 0 && document.referrer.length < 500) {
          out.referrer = document.referrer;
        }
        return out;
      } catch { return {}; }
    };
    const utmSnapshot = captureUtmSnapshot();

    // ── Audit-context capture (closes audit→pay→watchlist loop) ──
    // /audit page builds developerCtaUrl with &packages=axios,lodash,react&eco=npm.
    // Snapshot here so the post-payment /checkout/success page can offer a
    // one-click "watch these N packages from your audit" button — the
    // alternative is the user paying for Developer/Pro then manually
    // re-adding to /watchlist what they just audited 30s ago. We thread
    // packages + eco through /api/checkout-intent → Stripe metadata →
    // /api/checkout/session response. Snapshot at page load mirrors UTM
    // pattern (URL is canonical source, survives modal close/reopen).
    const captureAuditCtxSnapshot = (): { packages?: string; eco?: string } => {
      try {
        const sp = new URLSearchParams(window.location.search);
        const out: Record<string, string> = {};
        const rawPkgs = sp.get('packages') ?? '';
        // Validate: comma-separated package names, each matching shape used in
        // audit.astro (loose match for npm + pypi + cargo + golang). Cap total
        // length so a hostile URL can't bloat Stripe metadata (500-char limit
        // per metadata value).
        if (rawPkgs && rawPkgs.length > 0 && rawPkgs.length < 480) {
          const names = rawPkgs.split(',').map((n) => n.trim()).filter(Boolean);
          const valid = names.filter((n) => /^[@a-zA-Z0-9._/-]+$/.test(n) && n.length <= 214);
          if (valid.length > 0 && valid.length <= 10) {
            out.packages = valid.slice(0, 5).join(',');
          }
        }
        const rawEco = (sp.get('eco') ?? '').toLowerCase();
        if (rawEco && /^(npm|pypi|cargo|golang)$/.test(rawEco)) {
          out.eco = rawEco;
        }
        return out;
      } catch { return {}; }
    };
    const auditCtxSnapshot = captureAuditCtxSnapshot();

    // Build query suffix for GET fallback URL. URLSearchParams handles
    // encoding (so utm values with spaces/special chars don't break the URL).
    const utmQuerySuffix = (() => {
      const sp = new URLSearchParams();
      for (const [k, v] of Object.entries(utmSnapshot)) sp.set(k, v);
      // Forward audit-context to GET fallback too — symmetry with POST.
      for (const [k, v] of Object.entries(auditCtxSnapshot)) sp.set(k, v);
      const s = sp.toString();
      return s ? `&${s}` : '';
    })();

    // ── Email pre-fill from ?email= URL param ──
    // Backend 402/429/422 upgrade URLs (worker.ts buildUpgradeUrl) carry the
    // authenticated user's email so the CLI funnel (poc watch → 402 →
    // /pricing?email=...) lands with the modal pre-filled. Single re-type
    // step closed at the highest-stakes click in the funnel. Validated by
    // exporting EMAIL_RE in lock-step with /api/checkout-intent's accepted
    // shape (basic [^\s@]+@[^\s@]+\.[^\s@]+) — same regex used on submit
    // below, so an invalid pre-fill cannot pass through to /api/checkout.
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const prefillEmailFromUrl = (() => {
      try {
        const sp = new URLSearchParams(window.location.search);
        const v = sp.get('email');
        if (v && v.length < 200 && EMAIL_RE.test(v)) return v;
        return '';
      } catch { return ''; }
    })();

    function openModal(tier: string) {
      pendingTier = tier;
      if (modal) {
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        // Apply URL pre-fill on each open (closeModal resets the form), so
        // the user only has to type if the URL didn't carry their email or
        // they want to override. Focus the input regardless — if pre-filled
        // they can hit Enter; if empty they can type.
        if (emailInput && prefillEmailFromUrl && !emailInput.value) {
          emailInput.value = prefillEmailFromUrl;
        }
        emailInput?.focus();
      }
    }

    function closeModal() {
      if (modal) {
        modal.hidden = true;
        document.body.style.overflow = '';
        pendingTier = '';
        emailForm?.reset();
        if (emailError) emailError.hidden = true;
        if (submitBtn) { submitBtn.textContent = 'Continue to payment →'; submitBtn.disabled = false; }
      }
    }

    // Open modal on Subscribe button click
    document.querySelectorAll<HTMLButtonElement>('.checkout-btn').forEach((btn) => {
      btn.addEventListener('click', () => openModal(btn.dataset.tier ?? 'pro'));
    });

    // ── CLI-context banner (visitor came from CLI 402 wall) ──
    // CLI sends utm_campaign in {watch-cmd, watchlist-cmd, unwatch-cmd} after
    // 402 from /api/watchlist (npm-package/index.js printUpgradeRequired:1079/1111/1193).
    // Generic pricing page = lost context = 0 conversions from cli funnel. This
    // banner restores the "you tried to enable monitoring" moment and routes
    // to checkout modal with Developer pre-selected in one click. Hidden when
    // utm_campaign doesn't match — no regression for direct visitors. Banner
    // includes utm_campaign in its CTA → modal flow (utmSnapshot already
    // captures it for the POST to /api/checkout-intent above, so attribution
    // preserves through to Stripe metadata).
    (() => {
      const sp = new URLSearchParams(window.location.search);
      // 2026-06-12: ref→utm_campaign promotion for npm-package URLs that
      // emit ?ref=… on /pricing (currently only ci-annotation from v1.31.0
      // GitHub Actions annotation work). All earlier npm CTAs land here
      // with proper utm_* params; the v1.31.0 annotation shipped a `ref`
      // because it mirrors the /get-started?ref=ci-annotation free-tier
      // URL shape. Without this promotion the CONTEXT_BY_CAMPAIGN banner
      // stays silent (campaign='' → variant=undefined → return) AND the
      // Stripe metadata loses ci-annotation as utm_campaign — so paid CI
      // signups silently bucket as 'web' in api_keys.source.
      // Promote only when utm_campaign is unset so existing utm-tagged
      // URLs aren't overwritten by a stray ref.
      let campaign = sp.get('utm_campaign') ?? '';
      const refParam = sp.get('ref') ?? '';
      if (!campaign && refParam && /^[a-z0-9_-]{1,64}$/.test(refParam)) {
        campaign = refParam;
        // Mirror into utmSnapshot so the POST /api/checkout-intent body
        // carries utm_campaign=ci-annotation through to Stripe metadata.
        // utmSnapshot is captured once at page-load above; mutating it
        // here is safe — it's a plain object referenced by the modal flow.
        if (!utmSnapshot.utm_campaign) utmSnapshot.utm_campaign = refParam;
      }

      // ── Specificity-first headline for audit-critical-key ──
      // The audit page passes the user's actual CRITICAL package names via
      // ?packages=axios,lodash,react (audit.astro line ~1872). Generic copy
      // ("You audited CRITICAL packages") reads as a template; naming the
      // visitor's own packages converts higher because the reader recognizes
      // the package as theirs, not a hypothetical. Up to 3 names rendered
      // inline; overflow becomes "+N more". Empty/missing param → generic
      // fallback (no regression for direct visitors or stripped URLs).
      const buildAuditCriticalMsg = (): string => {
        const raw = sp.get('packages') ?? '';
        const pkgs = raw
          .split(',')
          .map((p) => p.trim())
          .filter((p) => p.length > 0 && p.length <= 214 && /^[@a-zA-Z0-9._/-]+$/.test(p));
        if (pkgs.length === 0) {
          return 'You audited CRITICAL packages with a free key. Free tier scores them on demand and weekly-digests up to 3 watched packages. Developer ($15/mo) adds daily re-scans + instant email alerts (vs weekly) and watches 15 packages (5× free) so the next compromise pages you, not your users.';
        }
        const shown = pkgs.slice(0, 3);
        const extra = pkgs.length - shown.length;
        const nameList =
          shown.length === 1
            ? shown[0]
            : shown.length === 2
              ? `${shown[0]} and ${shown[1]}`
              : `${shown.slice(0, -1).join(', ')}, and ${shown[shown.length - 1]}`;
        const overflow = extra > 0 ? ` (+${extra} more)` : '';
        const them = pkgs.length === 1 ? 'it' : 'them';
        return `You audited ${nameList}${overflow} — flagged CRITICAL today. Free tier scored ${them} once and can weekly-digest up to 3 watched packages. Developer ($15/mo) re-scans daily, watches 15 packages (5× free), and instantly emails you the moment any score drops a tier — so the next compromise pages you, not your users.`;
      };

      // ── Compromised-incident headline ──
      // Mirror of buildAuditCriticalMsg but for packages flagged as
      // confirmed supply-chain victims (incident registry). The redhat-miasma
      // article CTA path lands here when the user audits Red Hat packages and
      // signs up — naming the actual incident package converts higher than a
      // generic "you audited compromised packages" headline. Same package-name
      // sanitization as the critical-key branch.
      const buildAuditCompromisedMsg = (): string => {
        const raw = sp.get('packages') ?? '';
        const pkgs = raw
          .split(',')
          .map((p) => p.trim())
          .filter((p) => p.length > 0 && p.length <= 214 && /^[@a-zA-Z0-9._/-]+$/.test(p));
        if (pkgs.length === 0) {
          return 'You audited packages that were caught in a confirmed supply-chain attack. Behavioral scoring caught the burst once; Developer ($15/mo) watches up to 15 packages continuously, scans daily, and emails you the moment the next coordinated burst hits any of them — minutes, not weekly.';
        }
        const shown = pkgs.slice(0, 3);
        const extra = pkgs.length - shown.length;
        const nameList =
          shown.length === 1
            ? shown[0]
            : shown.length === 2
              ? `${shown[0]} and ${shown[1]}`
              : `${shown.slice(0, -1).join(', ')}, and ${shown[shown.length - 1]}`;
        const overflow = extra > 0 ? ` (+${extra} more)` : '';
        return `You audited ${nameList}${overflow} — caught in a confirmed supply-chain attack. Free tier scored them once and can weekly-digest up to 3 watched packages. Developer ($15/mo) watches 15 packages (5× free), re-scans daily, and instantly emails you the moment the same maintainer cluster publishes a new coordinated burst — so the next compromise pages you, not your users.`;
      };

      // ── Clean-audit headline ──
      // Mirror of buildAuditCriticalMsg / buildAuditCompromisedMsg but for the
      // healthy branch: visitor's tree had no CRITICAL flags. Their mental
      // state ("no problem found") is the hardest sell, so the copy anchors
      // on the temporal asymmetry — axios scored clean until March 30, when
      // a stolen token shipped malware to 11M weekly downloads. Naming the
      // visitor's actual packages converts higher than a generic "you
      // audited a clean tree" headline; the article→audit deep-link path
      // already routes named packages through to here. Same sanitization
      // as the critical/compromised branches.
      const buildAuditHealthyMsg = (): string => {
        const raw = sp.get('packages') ?? '';
        const pkgs = raw
          .split(',')
          .map((p) => p.trim())
          .filter((p) => p.length > 0 && p.length <= 214 && /^[@a-zA-Z0-9._/-]+$/.test(p));
        if (pkgs.length === 0) {
          return 'You audited a clean tree — no CRITICAL flags today. Packages change hands; axios scored clean until March 30, when a stolen npm token shipped malware to 11M weekly downloads. Developer ($15/mo) re-scans your tree daily, watches up to 15 packages, and emails you within minutes the moment any score drops a tier — so the next compromise pages you, not your users.';
        }
        const shown = pkgs.slice(0, 3);
        const extra = pkgs.length - shown.length;
        const nameList =
          shown.length === 1
            ? shown[0]
            : shown.length === 2
              ? `${shown[0]} and ${shown[1]}`
              : `${shown.slice(0, -1).join(', ')}, and ${shown[shown.length - 1]}`;
        const overflow = extra > 0 ? ` (+${extra} more)` : '';
        const them = pkgs.length === 1 ? 'it' : 'them';
        return `You audited ${nameList}${overflow} — clean today. axios scored clean too, until a stolen token shipped malware to 11M weekly downloads on March 30. Developer ($15/mo) re-scans ${them} daily, watches up to 15 packages (5× free), and emails you within minutes the moment any score drops a tier — so the next compromise pages you, not your users.`;
      };

      // 2026-06-15: checkout-recovery — abandonment-recovery email after a
      // Stripe checkout.session.expired (worker.ts:8028). HIGHEST intent in
      // the funnel: visitor created a free key, hit a limit, clicked the
      // upgrade URL, entered Stripe, then bailed. Pre-this-ship, the recovery
      // email link was bare `https://getcommit.dev/pricing` — strip email,
      // strip utm_campaign, strip tier. Visitor had to re-type email, re-find
      // the tier they were on, re-click Subscribe. Same orphan-banner class
      // as 2026-06-12 ci-annotation, 2026-06-10 audit-healthy-key, and the
      // 2026-06-15 04:35Z batch (free-watch-cmd, upgrade-from-free-key,
      // status-limit, post-login, init, help). Recovery email now carries
      // email + utm_campaign=checkout-recovery + utm_medium=recovery + tier=
      // {pro|developer}. Banner reads tier from URL, msg picks Developer vs
      // Pro copy, CTA opens the matching modal so the next click resumes
      // the abandoned flow at the original tier.
      const buildRecoveryMsg = (): string => {
        const tierParam = sp.get('tier');
        const isPro = tierParam === 'pro';
        if (isPro) {
          return 'You started a Pro ($29/mo) checkout but didn\'t finish. Pro unlocks 10,000 audits/month, batch up to 20 packages per call, monitors 10 projects with daily re-scans, sends alerts to Slack + webhooks (vs email-only on Developer), and keeps 90 days of historical score data. 30-day money-back guarantee — pick up where you left off.';
        }
        return 'You started a Developer ($15/mo) checkout but didn\'t finish. Developer unlocks 1,000 audits/day, batch up to 5 packages per call, watches 15 packages with daily re-scans (vs 3 weekly on free), and adds instant email alerts the moment any score drops a tier. 30-day money-back guarantee — pick up where you left off.';
      };

      const CONTEXT_BY_CAMPAIGN: Record<string, { eyebrow: string; msg: string }> = {
        'watch-cmd': {
          eyebrow: 'From your terminal',
          msg: 'You hit the 3-package free-tier watchlist cap. Developer ($15/mo) raises it to 15 packages (5× free), upgrades the weekly digest to daily scans, and adds instant email alerts the moment any score drops a tier.',
        },
        'watchlist-cmd': {
          eyebrow: 'From your terminal',
          msg: 'You hit a free-tier limit. Developer ($15/mo) raises the watchlist to 15 packages (5× free), upgrades the weekly digest to daily scans, and adds instant email alerts the moment something degrades.',
        },
        'unwatch-cmd': {
          eyebrow: 'From your terminal',
          msg: 'You hit a free-tier limit. Developer ($15/mo) raises the watchlist to 15 packages (5× free), upgrades the weekly digest to daily scans, and adds instant email alerts the moment something degrades.',
        },
        'audit-critical-key': {
          eyebrow: 'From your audit results',
          msg: buildAuditCriticalMsg(),
        },
        'audit-compromised-key': {
          eyebrow: 'From your audit results',
          msg: buildAuditCompromisedMsg(),
        },
        // 2026-06-10: clean-audit users (the majority of audits) previously
        // had no campaign attribution arriving at /pricing — the banner
        // stayed silent for the largest cohort. Now the audit.astro healthy
        // branch passes &utm_campaign=audit-healthy-key and pre-loads up to
        // 5 audited package names. Stripe webhook attribution (worker.ts:6989
        // VALID_PAID_SOURCE_RE) accepts this campaign tag — paid signups
        // from this surface land in api_keys.source='audit-healthy-key'
        // instead of silently bucketing to 'web'. Symmetric to audit-
        // critical-key / audit-compromised-key.
        'audit-healthy-key': {
          eyebrow: 'From your audit results',
          msg: buildAuditHealthyMsg(),
        },
        // 2026-06-10: audit-overshoot fires when a visitor's IP has burned
        // past 4× the free anonymous limit (worker.ts AUDIT_OVERSHOOT_AT)
        // and clicks through the rescue surface. By the time they land here,
        // a free key — 200/day — is a holding pattern, not a fit: the
        // shared-IP heuristic might explain part of it, but the behavior
        // itself is heavy-use. Pitch Developer ($15/mo, 1000/day, batch up
        // to 5 per call) over Free, framed as "you already outgrew it".
        // Free remains available on /pricing for visitors who self-correct.
        'audit-overshoot': {
          eyebrow: 'From your audit results',
          msg: 'You blew past the free-tier audit limit on this IP today. A free key gives 200/day — useful for a project audit, but you\'d hit that wall again. Developer ($15/mo) gives 1,000 audits/day, batch up to 5 packages per call, daily re-scans on up to 15 watched packages, and instant email alerts when any of them changes. 30-day money-back.',
        },
        // 2026-06-10: key-upgrade fires when a signed-in free user clicks an
        // upgrade prompt from any authenticated surface — dashboard "See plans",
        // /api/audit 429 (own-key quota), /api/* 402 (pro feature on free tier),
        // or /api/watchlist 422 (package cap). Backend buildUpgradeUrl writes
        // utm_campaign=key-upgrade + utm_source=key + utm_medium=<surface>.
        // The visitor has already invested attention (signed up, used the key,
        // hit a limit) — banner reframes /pricing as "you're a returning user,
        // here's the next step", not "please consider Commit". Pre-selects
        // Developer in the modal.
        'key-upgrade': {
          eyebrow: 'From your Commit account',
          msg: 'You hit a free-tier limit. Developer ($15/mo) gives 1,000 audits/day, batch up to 5 packages per call, watches 15 packages (vs 3 free) with daily re-scans, and adds instant email alerts the moment any score drops a tier. 30-day money-back guarantee.',
        },
        // 2026-06-12: ci-annotation fires for visitors arriving via the
        // GitHub Actions PR-checks annotation shipped in npm-package v1.31.0.
        // The annotation surfaces in CI when an authenticated key has hit
        // its quota (keyUpgrade branch) or an anonymous IP has burned past
        // the overshoot threshold — both reach /pricing as the upgrade
        // destination. By the time they're here they already wired Commit
        // into a workflow, hit a wall, and decided to look at upgrades:
        // highest-intent surface in the funnel. Pitch Developer's 1,000/day
        // + batch + 15-package watch in CI-shaped language ("every PR" +
        // "every push") so the copy mirrors the moment they came from.
        'ci-annotation': {
          eyebrow: 'From your PR checks',
          msg: 'Your CI hit a Commit rate limit on this repo. Free key gives 200 audits/day — works for a small project but not every PR on every push. Developer ($15/mo) gives 1,000 audits/day, batches up to 5 packages per call, watches 15 packages with daily re-scans, and instantly emails you the moment any score drops a tier. 30-day money-back guarantee.',
        },
        // 2026-06-15: free-watch-cmd fires from the free-tier weekly digest
        // email (worker.ts:6715). Recipient is a free-tier user who has 1–3
        // watched packages and just received a weekly score report — their
        // strongest re-engagement moment with the product. URL carries
        // ?email=... so the modal pre-fills on click. Pre-2026-06-15 the
        // banner stayed silent (variant lookup missed) and /pricing read as
        // generic to the visitor most likely to convert that week. Same
        // class of bug as the 2026-06-12 ci-annotation fix and the
        // 2026-06-10 audit-healthy-key fix — campaign tag emitted but no
        // matching CONTEXT_BY_CAMPAIGN entry.
        'free-watch-cmd': {
          eyebrow: 'From your weekly digest',
          msg: 'You\'re watching packages on the free tier (3 packages, weekly digest). Developer ($15/mo) raises the watchlist to 15 packages (5× free), upgrades the weekly digest to daily re-scans, and adds instant email alerts the moment any score drops a tier — minutes after the burst, not the following Monday.',
        },
        // 2026-06-15: upgrade-from-free-key fires when a user clicks the
        // "Upgrade to Developer — $15/mo →" button on /get-started right
        // after creating a free key (get-started.astro:189-190). Highest
        // possible intent — they just signed up, saw the product surface,
        // and explicitly clicked Upgrade. The previous silent banner read
        // as generic /pricing despite the visitor coming directly from
        // their fresh signup. Most-frequent orphan campaign by volume.
        'upgrade-from-free-key': {
          eyebrow: 'From your fresh signup',
          msg: 'You just created a free Commit key and clicked Upgrade. Developer ($15/mo) watches 15 packages (vs 3 free) with daily re-scans, gives 1,000 audits/day, batches up to 5 packages per call, and adds instant email alerts the moment any score drops a tier. 30-day money-back guarantee.',
        },
        // 2026-06-15: CLI campaign tags from npm-package/index.js. Each
        // fires from a distinct CLI surface but the visitor's mental state
        // is similar: they\'re in their terminal, they\'ve seen Commit
        // output, they clicked an upgrade link. Surface-specific eyebrows
        // anchor the copy to the moment they came from; the msg pitches
        // Developer across all four since the underlying intent is the
        // same upgrade decision.
        'status-limit': {
          eyebrow: 'From your terminal',
          msg: '`poc status` flagged your free-tier limit. Developer ($15/mo) gives 1,000 audits/day, watches 15 packages (5× free) with daily re-scans, and emails you the moment any score drops a tier — so the next time you run `poc status`, the wall is gone.',
        },
        'post-login': {
          eyebrow: 'From your terminal',
          msg: 'You just signed into Commit from the CLI. Developer ($15/mo) watches 15 packages (vs 3 free) with daily re-scans, gives 1,000 audits/day, batches up to 5 packages per call, and adds instant email alerts the moment any score drops a tier. 30-day money-back guarantee.',
        },
        'init': {
          eyebrow: 'From your terminal',
          msg: 'You just ran `poc init` to wire Commit into your project. Developer ($15/mo) watches 15 packages with daily re-scans (vs 3 packages weekly on free), gives 1,000 audits/day, batches up to 5 packages per call, and adds instant email alerts the moment any score drops a tier.',
        },
        'help': {
          eyebrow: 'From your terminal',
          msg: 'You followed the monitoring link from `poc --help`. Developer ($15/mo) watches 15 packages with daily re-scans (vs 3 weekly on free), gives 1,000 audits/day, batches up to 5 packages per call, and adds instant email alerts the moment any score drops a tier. 30-day money-back guarantee.',
        },
        // 2026-06-15: see buildRecoveryMsg() above for rationale. Single
        // eyebrow + tier-conditional msg; the banner CTA also reads ?tier=
        // so the modal opens at the tier the visitor abandoned.
        'checkout-recovery': {
          eyebrow: 'From your abandoned checkout',
          msg: buildRecoveryMsg(),
        },
      };
      const variant = CONTEXT_BY_CAMPAIGN[campaign];
      if (!variant) return;
      const banner = document.getElementById('cli-context-banner') as HTMLElement | null;
      const eyebrowEl = document.getElementById('cli-context-eyebrow') as HTMLElement | null;
      const msgEl = document.getElementById('cli-context-msg') as HTMLElement | null;
      const ctaEl = document.getElementById('cli-context-cta') as HTMLButtonElement | null;
      if (!banner || !eyebrowEl || !msgEl || !ctaEl) return;
      eyebrowEl.textContent = variant.eyebrow;
      msgEl.textContent = variant.msg;
      banner.hidden = false;
      // 2026-06-15: tier-aware CTA. Pre-this-ship, openModal('developer') was
      // hardcoded for every campaign. checkout-recovery NEEDS to honor the
      // tier the visitor abandoned (Pro $29 vs Developer $15) or the banner
      // CTA pivots the user mid-flow into the wrong tier modal. Read ?tier=
      // from URL with a 2-value safelist; default 'developer' preserves the
      // pre-ship behavior for every other campaign that omits the param.
      const tierParam = sp.get('tier');
      const ctaTier = (tierParam === 'pro' || tierParam === 'developer') ? tierParam : 'developer';
      ctaEl.addEventListener('click', () => openModal(ctaTier));
    })();

    // Close on overlay click or close button
    modalOverlay?.addEventListener('click', closeModal);
    modalClose?.addEventListener('click', closeModal);

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
    });

    // Submit → POST checkout-intent (stores lead) then redirect to Stripe
    emailForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput?.value.trim() ?? '';
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (emailError) { emailError.textContent = 'Enter a valid email address.'; emailError.hidden = false; }
        return;
      }
      if (emailError) emailError.hidden = true;
      if (submitBtn) { submitBtn.textContent = 'Redirecting…'; submitBtn.disabled = true; }

      // ── Helper: surface a clear error in the modal instead of silently redirecting ──
      // Previously, any non-ok JSON response fell through to the GET /api/checkout
      // fallback, which often ALSO failed (same rate limiter, same Stripe outage) and
      // redirected to /pricing/?error=... with no UI for it. Visitor saw nothing and
      // bounced. Now: show the message in-modal, reset the button so they can retry.
      const showModalError = (msg: string) => {
        if (emailError) { emailError.textContent = msg; emailError.hidden = false; }
        if (submitBtn) { submitBtn.textContent = 'Continue to payment →'; submitBtn.disabled = false; }
      };

      try {
        const resp = await fetch('https://poc-backend.amdal-dev.workers.dev/api/checkout-intent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, tier: pendingTier, ...utmSnapshot, ...auditCtxSnapshot }),
        });

        let data: { ok?: boolean; checkout_url?: string; error?: string; message?: string } | null = null;
        try { data = await resp.json(); } catch { data = null; }

        if (resp.ok && data?.ok && data.checkout_url) {
          // Happy path → Stripe.
          window.location.href = data.checkout_url;
          return;
        }

        // Known structured errors from the backend (or edge 429): show in modal.
        // Strings short on purpose — modal real estate is tight, and the
        // surface should be "actionable hint, not a wall of text."
        const errCode = data?.error ?? '';
        if (resp.status === 429 || errCode === 'rate_limit_exceeded') {
          showModalError('Checkout is busy right now. Please retry in a few minutes — or grab a free API key below to start using Commit immediately.');
          return;
        }
        if (resp.status === 400 && errCode === 'invalid_email') {
          showModalError('Please enter a valid email address.');
          return;
        }
        if (resp.status === 400 && errCode === 'invalid_tier') {
          showModalError('That plan is not available. Please refresh the page and try again.');
          return;
        }
        if (resp.status === 502 || errCode === 'checkout_failed') {
          showModalError('Could not reach our payment provider. Please retry in a few minutes — or email pico@amdal.dev if it persists.');
          return;
        }
        if (resp.status === 503 || errCode === 'tier_unavailable' || errCode === 'stripe_not_configured') {
          showModalError('That plan is temporarily unavailable. Please retry in a few minutes — or email pico@amdal.dev.');
          return;
        }

        // Genuinely unexpected status with no structured error: fall back to
        // the GET /api/checkout path (preserves prior behavior for edge cases
        // outside the known error matrix above).
        window.location.href = `/api/checkout?tier=${encodeURIComponent(pendingTier)}&email=${encodeURIComponent(email)}${utmQuerySuffix}`;
      } catch {
        // True network failure (DNS, offline, CORS denial) — try the GET path
        // which avoids the JSON contract entirely and ends in a Stripe 302.
        window.location.href = `/api/checkout?tier=${encodeURIComponent(pendingTier)}&email=${encodeURIComponent(email)}${utmQuerySuffix}`;
      }
    });

    // ── URL ?error= surfacing — restores the failure feedback after a Stripe redirect ──
    // The GET /api/checkout fallback redirects back to /pricing/?error=... when
    // the Stripe call fails. Before this handler, the page rendered with no UI
    // for that error and the visitor bounced. Now: read the param, populate the
    // banner above the tiers, and replaceState so a refresh clears it.
    (() => {
      try {
        const sp = new URLSearchParams(window.location.search);
        const err = sp.get('error');
        if (!err) return;

        const banner = document.getElementById('checkout-error-banner') as HTMLElement | null;
        const msgEl = document.getElementById('checkout-error-msg') as HTMLElement | null;
        const subEl = document.getElementById('checkout-error-sub') as HTMLElement | null;
        if (!banner || !msgEl || !subEl) return;

        const variants: Record<string, { msg: string; sub: string }> = {
          rate_limit_exceeded: {
            msg: 'Checkout is busy right now. Please retry in a few minutes.',
            sub: 'You can also grab a free API key below — no card required — and upgrade later.',
          },
          checkout_failed: {
            msg: 'We could not reach the payment provider just now.',
            sub: 'Please retry in a few minutes. If it keeps happening, email <a href="mailto:pico@amdal.dev">pico@amdal.dev</a> and we will sort it out.',
          },
          tier_unavailable: {
            msg: 'That plan is temporarily unavailable.',
            sub: 'Please retry in a few minutes or email <a href="mailto:pico@amdal.dev">pico@amdal.dev</a> if you need it now.',
          },
        };
        const variant = variants[err] ?? {
          msg: 'Something interrupted your checkout.',
          sub: 'Please try the Subscribe button again. If it keeps happening, email <a href="mailto:pico@amdal.dev">pico@amdal.dev</a>.',
        };

        msgEl.textContent = variant.msg;
        subEl.innerHTML = variant.sub;
        banner.hidden = false;

        // Clean the URL so refresh does not re-show the banner. Preserves
        // any utm_* / referrer params already captured by the snapshot above.
        try {
          sp.delete('error');
          const cleaned = sp.toString();
          const newUrl = window.location.pathname + (cleaned ? '?' + cleaned : '') + window.location.hash;
          window.history.replaceState({}, '', newUrl);
        } catch {
          // replaceState can fail in rare cases (file://, certain extensions) — non-fatal.
        }
      } catch {
        // Defensive: do not break the page if URL parsing/DOM lookup fails.
      }
    })();

    // ── Waitlist form ──
    // Inline-key reveal on success (parity with /get-started/, shipped 2026-05-23).
    // Backend /api/keys/create returns { key, key_prefix } in JSON since the
    // INLINE_KEY_SOURCES gate was removed — display the key on this page so the
    // visitor doesn't have to context-switch to inbox. Email is a backup, not a
    // gate. Source 'web-pricing' is whitelisted in worker.ts VALID_SOURCES so
    // we can measure pricing-page conversions distinct from /get-started/ ones.
    const waitlistForm = document.getElementById('waitlist-form') as HTMLFormElement | null;
    if (waitlistForm) {
      waitlistForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const emailInput = document.getElementById('waitlist-email') as HTMLInputElement;
        const submitBtn = document.getElementById('waitlist-btn') as HTMLButtonElement;
        const successBox = document.getElementById('waitlist-success') as HTMLDivElement;
        const successTitle = document.getElementById('waitlist-success-title') as HTMLParagraphElement;
        const keyDisplay = document.getElementById('waitlist-key-display') as HTMLElement;
        const successNote = document.getElementById('waitlist-success-note') as HTMLParagraphElement;
        const successBackup = document.getElementById('waitlist-success-backup') as HTMLParagraphElement;
        const errorMsg = document.getElementById('waitlist-error') as HTMLParagraphElement;
        const email = emailInput.value.trim();

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          errorMsg.textContent = 'Please enter a valid email address.';
          errorMsg.hidden = false;
          successBox.hidden = true;
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Generating…';
        errorMsg.hidden = true;
        successBox.hidden = true;
        keyDisplay.hidden = true;
        successNote.hidden = true;
        successBackup.hidden = true;

        try {
          // POSTs to /api/keys/create — same endpoint /get-started/ uses.
          // source='web-pricing' so we can split funnel conversion vs the
          // direct /get-started/ landing.
          const res = await fetch('https://poc-backend.amdal-dev.workers.dev/api/keys/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, source: 'web-pricing' }),
          });
          if (res.ok || res.status === 201) {
            const data = await res.json() as { key?: string; key_prefix?: string; message?: string };
            successBox.hidden = false;
            waitlistForm.reset();
            submitBtn.textContent = 'Get free API key';

            if (data?.key) {
              // Inline reveal — primary path. Email is backup.
              successTitle.textContent = '✓ Your free API key';
              keyDisplay.textContent = data.key;
              keyDisplay.hidden = false;
              successNote.hidden = false;
              successBackup.textContent = 'Backup also sent to ' + email + '.';
              successBackup.hidden = false;
            } else {
              // Backup path — backend couldn't return key (RESEND failure?).
              successTitle.textContent = '✓ API key sent to ' + email + ' — check your inbox.';
            }

            // Pre-fill upgrade buttons with the email so Stripe checkout doesn't
            // ask the user to retype it (and so the paid key binds to the same
            // address as the free key).
            const emailEnc = encodeURIComponent(email);
            document.querySelectorAll<HTMLAnchorElement>('.checkout-btn, .upgrade-btn').forEach((btn) => {
              const href = btn.getAttribute('href') ?? '';
              if (href.includes('/api/checkout')) {
                try {
                  const url = new URL(href);
                  url.searchParams.set('email', email);
                  btn.setAttribute('href', url.toString());
                } catch {
                  const sep = href.includes('?') ? '&' : '?';
                  btn.setAttribute('href', href + sep + 'email=' + emailEnc);
                }
              }
            });
          } else {
            const data = await res.json() as any;
            throw new Error(data?.message ?? data?.error ?? `HTTP ${res.status}`);
          }
        } catch (err) {
          errorMsg.textContent = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
          errorMsg.hidden = false;
          submitBtn.textContent = 'Get free API key';
        } finally {
          submitBtn.disabled = false;
        }
      });
    }
  </script>

