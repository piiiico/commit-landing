  <!-- Email capture modal (shown before Stripe redirect) -->
  <div id="checkout-modal" class="checkout-modal" hidden role="dialog" aria-modal="true" aria-labelledby="checkout-modal-title">
    <div class="checkout-modal-overlay"></div>
