      <form id="checkout-email-form" novalidate>
        <input
          id="checkout-email"
          type="email"
          name="email"
          placeholder="you@company.com"
          autocomplete="email"
          required
          class="checkout-modal-input"
        />
        <p id="checkout-email-error" class="checkout-modal-error" hidden></p>
        <button type="submit" id="checkout-submit-btn" class="checkout-modal-submit">Continue to payment →</button>
      </form>
      <p class="checkout-modal-fine">Secure checkout via Stripe. Cancel anytime.</p>
    </div>
