        </div>
        <div class="waitlist-form-area">
          <form id="waitlist-form" class="waitlist-form" novalidate>
            <div class="waitlist-input-row">
              <input
                id="waitlist-email"
                type="email"
                name="email"
                placeholder="you@company.com"
                autocomplete="email"
                required
                class="waitlist-input"
              />
              <button type="submit" id="waitlist-btn" class="waitlist-submit">
                Get free API key
              </button>
            </div>
            <div id="waitlist-success" class="waitlist-feedback waitlist-success" hidden>
              <p class="waitlist-success-title" id="waitlist-success-title">
                ✓ Your free API key
              </p>
              <code id="waitlist-key-display" class="waitlist-key-display" hidden></code>
              <p class="waitlist-success-note" id="waitlist-success-note" hidden>
                Save this key — it won't be shown again. Use it as
                <code class="waitlist-inline-code">Authorization: Bearer &lt;key&gt;</code>.
              </p>
