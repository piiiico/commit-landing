---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Commit Pricing — Free for devs, $15/mo for builders, $29/mo for teams"
  description="Open source and free forever for individual developers. Developer at $15/month for builders. Pro at $29/month for teams — per project, not per seat. Enterprise at $199/month for compliance and unlimited scale."
  canonical="https://getcommit.dev/pricing/"
>
  <!-- Nav -->
  <nav>
    <div class="container nav-inner">
      <a href="/" class="nav-brand">Commit</a>
      <ul class="nav-links">
        <li><a href="/#mcp">MCP</a></li>
        <li><a href="/audit">Audit</a></li>
        <li><a href="/watchlist">Watchlist</a></li>
        <li><a href="/extension">Extension</a></li>
        <li><a href="/blog">Writing</a></li>
        <li><a href="/pricing">Pricing</a></li><li><a href="/docs">Docs</a></li><li><a href="https://github.com/piiiico/proof-of-commitment" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="mailto:pico@amdal.dev">Contact</a></li>
      </ul>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pricing-hero">
    <div class="container">
      <div class="editorial" style="max-width: var(--max-content); margin: 0 auto;">
        <span class="hero-eyebrow">Pricing</span>
        <h1 class="pricing-title">
          Free for devs.<br />
          <em>$15/mo for builders. $29/mo for teams.</em>
        </h1>
        <p class="pricing-lead">
          The CLI, web audit, and single-package API are <strong>free forever</strong>.
          Developer ($15/mo) adds batch scanning and CI/CD automation for builders.
          Pro ($29/mo) adds team-scale monitoring and alerts — priced per project,
          not per seat. A 50-person team pays the same as a 5-person team.
        </p>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- CLI-context banner — shown when utm_campaign matches a CLI-cmd campaign. -->
  <!-- Visitor hit a 402 wall in the terminal (watch/watchlist/unwatch); generic -->
  <!-- pricing page loses that context, which kills CLI→paid conversion. Banner -->
  <!-- restores the "you tried to enable monitoring" moment and opens checkout -->
  <!-- modal pre-set to Developer tier. Hidden by default — zero regression for -->
  <!-- direct visitors. See JS handler near openModal() below. -->
  <section id="cli-context-banner" class="cli-context-section" hidden>
    <div class="container">
      <div class="cli-context-card">
        <p class="cli-context-eyebrow" id="cli-context-eyebrow">From your terminal</p>
        <p class="cli-context-msg" id="cli-context-msg"></p>
        <button type="button" id="cli-context-cta" class="cli-context-btn" data-tier="developer">
          Continue with Developer — $15/mo →
        </button>
        <p class="cli-context-sub">
          30-day money-back · Cancel anytime · No card to keep using the free key
        </p>
      </div>
    </div>
  </section>

  <!-- Checkout-error banner — surfaces ?error= from URL after Stripe redirect failure -->
  <!-- Previously: backend 429 or 5xx on /api/checkout-intent → modal fell through to -->
  <!-- GET /api/checkout → that also failed → 302 to /pricing/?error=... → page rendered -->
  <!-- with no UI for the error. Visitor saw nothing and bounced. This banner restores -->
  <!-- the failure feedback loop. Errors handled: rate_limit_exceeded, checkout_failed, -->
  <!-- tier_unavailable. JS handler reads URL, replaces history state (so refresh clears -->
  <!-- the banner), and reveals the section. -->
  <section id="checkout-error-banner" class="checkout-error-section" hidden>
    <div class="container">
      <div class="checkout-error-card">
        <p class="checkout-error-eyebrow">Checkout interrupted</p>
        <p class="checkout-error-msg" id="checkout-error-msg"></p>
        <p class="checkout-error-sub" id="checkout-error-sub"></p>
      </div>
    </div>
  </section>

  <!-- Social-proof banner (populated from /api/stats/teams-protected) -->
  <!-- Visible by default with fallback; JS upgrades to live count if count >= 5. -->
  <section id="social-proof" class="social-proof-section">
    <div class="container">
      <p class="social-proof-line">
        <span class="social-proof-dot" aria-hidden="true">●</span>
        <span id="social-proof-text">Teams shipping with Commit this week.</span>
      </p>
    </div>
  </section>

  <!-- Attack timeline — real incidents, real data -->
  <section class="attack-timeline-section">
    <div class="container">
      <div class="editorial reveal" style="max-width: var(--max-content); margin: 0 auto;">
        <span class="section-label">Why monitoring matters</span>
        <h2 class="section-heading" style="margin-bottom: 1.5rem;">Three attacks. Same structural pattern. <em>All flagged beforehand.</em></h2>
      </div>
      <div class="attack-timeline-grid">
        <div class="attack-card">
          <time class="attack-date">Mar 2026</time>
          <strong class="attack-name">LiteLLM</strong>
          <p class="attack-desc">Backdoored CI pipeline. 1 npm publisher, 4M+ weekly downloads. Commit score: CRITICAL before the incident.</p>
        </div>
        <div class="attack-card">
          <time class="attack-date">Mar 30, 2026</time>
          <strong class="attack-name">axios</strong>
          <p class="attack-desc">Stolen npm credentials. 1 publisher, 99M weekly downloads, OpenSSF Scorecard 8.1/10. Commit score: CRITICAL.</p>
        </div>
        <div class="attack-card">
          <time class="attack-date">May 19, 2026</time>
          <strong class="attack-name">Shai-Hulud</strong>
          <p class="attack-desc">Self-replicating worm. 637 package versions in 39 minutes. Installed Claude Code &amp; VS Code persistence hooks. <a href="/blog/shai-hulud-claude-code-hook/" style="color: var(--accent);">Two OpenAI devices affected.</a></p>
        </div>
      </div>
      <p class="attack-bottom-line">
        <code>npm audit</code> flagged none of these beforehand. Behavioral signals flagged all of them.
        <strong>Monitoring catches score changes before the next one reaches your tree.</strong>
      </p>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Pricing tiers -->
  <section class="tiers-section">
