    .faq-a code {
      font-family: var(--font-mono);
      font-size: 0.85em;
      background: var(--surface);
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      color: var(--ink);
    }

    /* ── CTA ── */
    .cta-section {
      padding: 5rem 0;
      background: var(--paper);
    }

    .cta-heading {
      font-family: var(--font-display);
      font-size: 2rem;
      color: var(--ink);
      margin-bottom: 0.75rem;
