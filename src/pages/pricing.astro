  <footer>
    <div class="container footer-inner">
      <span class="footer-brand">Commit</span>
      <span class="footer-copy">Behavioral trust for the software supply chain.</span>
      <nav class="footer-links">
        <a href="/audit">Audit</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/pricing">Pricing</a>
        <a href="/blog">Writing</a>
        <a href="mailto:pico@amdal.dev">Contact</a>
      </nav>
    </div>
  </footer>

  <script>
    // ── Social-proof banner (populated from /api/stats/teams-protected) ──
    // Suppressed if count < 5 (handled server-side in the endpoint: period="none").
    (async () => {
      try {
        const resp = await fetch('https://poc-backend.amdal-dev.workers.dev/api/stats/teams-protected');
        if (!resp.ok) return;
        const data = await resp.json() as { ok?: boolean; count?: number; period?: string };
        if (!data.ok || !data.count || !data.period || data.period === 'none') return;
        const banner = document.getElementById('social-proof');
        const text = document.getElementById('social-proof-text');
        if (!banner || !text) return;
        const periodLabel: Record<string, string> = {
          '7d': 'this week',
          '30d': 'this month',
          'total': 'so far',
        };
        const label = periodLabel[data.period] ?? 'recently';
        text.textContent = `${data.count} teams started using Commit ${label}.`;
        banner.hidden = false;
      } catch {
        // Silent fail — social proof is non-critical.
      }
    })();

    // ── Checkout email modal ──
    const modal = document.getElementById('checkout-modal') as HTMLDivElement | null;
    const modalOverlay = modal?.querySelector('.checkout-modal-overlay');
    const modalClose = document.getElementById('checkout-modal-close') as HTMLButtonElement | null;
    const emailForm = document.getElementById('checkout-email-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('checkout-email') as HTMLInputElement | null;
    const emailError = document.getElementById('checkout-email-error') as HTMLParagraphElement | null;
    const submitBtn = document.getElementById('checkout-submit-btn') as HTMLButtonElement | null;
    let pendingTier = '';

    // ── UTM attribution capture (closes /pricing → /api/checkout-intent gap) ──
    // CLI funnel sends ?utm_source=cli&utm_campaign=watch-cmd (v1.18.2). Before
    // this, the API POST stripped UTMs at the body boundary, so paid Developer
    // conversions weren't attributable to the funnel. We now snapshot UTMs at
    // page load (URL is the canonical source — survives modal close/reopen)
    // and forward them into both POST checkout-intent + GET checkout fallback.
    const captureUtmSnapshot = (): {
      utm_source?: string; utm_medium?: string; utm_campaign?: string;
      utm_content?: string; utm_term?: string; referrer?: string;
    } => {
      try {
        const sp = new URLSearchParams(window.location.search);
        const out: Record<string, string> = {};
        for (const k of ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'] as const) {
          const v = sp.get(k);
          if (v && v.length > 0 && v.length < 200) out[k] = v;
        }
        if (document.referrer && document.referrer.length > 0 && document.referrer.length < 500) {
          out.referrer = document.referrer;
        }
        return out;
      } catch { return {}; }
    };
    const utmSnapshot = captureUtmSnapshot();

    // Build query suffix for GET fallback URL. URLSearchParams handles
    // encoding (so utm values with spaces/special chars don't break the URL).
    const utmQuerySuffix = (() => {
      const sp = new URLSearchParams();
      for (const [k, v] of Object.entries(utmSnapshot)) sp.set(k, v);
      const s = sp.toString();
      return s ? `&${s}` : '';
    })();

    // ── Email pre-fill from ?email= URL param ──
    // Backend 402/429/422 upgrade URLs (worker.ts buildUpgradeUrl) carry the
    // authenticated user's email so the CLI funnel (poc watch → 402 →
    // /pricing?email=...) lands with the modal pre-filled. Single re-type
    // step closed at the highest-stakes click in the funnel. Validated by
    // exporting EMAIL_RE in lock-step with /api/checkout-intent's accepted
    // shape (basic [^\s@]+@[^\s@]+\.[^\s@]+) — same regex used on submit
    // below, so an invalid pre-fill cannot pass through to /api/checkout.
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const prefillEmailFromUrl = (() => {
      try {
        const sp = new URLSearchParams(window.location.search);
        const v = sp.get('email');
        if (v && v.length < 200 && EMAIL_RE.test(v)) return v;
        return '';
      } catch { return ''; }
    })();

    function openModal(tier: string) {
      pendingTier = tier;
      if (modal) {
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        // Apply URL pre-fill on each open (closeModal resets the form), so
        // the user only has to type if the URL didn't carry their email or
        // they want to override. Focus the input regardless — if pre-filled
        // they can hit Enter; if empty they can type.
        if (emailInput && prefillEmailFromUrl && !emailInput.value) {
          emailInput.value = prefillEmailFromUrl;
        }
        emailInput?.focus();
      }
    }

    function closeModal() {
      if (modal) {
        modal.hidden = true;
        document.body.style.overflow = '';
        pendingTier = '';
        emailForm?.reset();
        if (emailError) emailError.hidden = true;
        if (submitBtn) { submitBtn.textContent = 'Continue to payment →'; submitBtn.disabled = false; }
      }
    }

    // Open modal on Subscribe button click
    document.querySelectorAll<HTMLButtonElement>('.checkout-btn').forEach((btn) => {
      btn.addEventListener('click', () => openModal(btn.dataset.tier ?? 'pro'));
    });

    // Close on overlay click or close button
    modalOverlay?.addEventListener('click', closeModal);
    modalClose?.addEventListener('click', closeModal);

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
    });

    // Submit → POST checkout-intent (stores lead) then redirect to Stripe
    emailForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput?.value.trim() ?? '';
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (emailError) { emailError.textContent = 'Enter a valid email address.'; emailError.hidden = false; }
        return;
      }
      if (emailError) emailError.hidden = true;
      if (submitBtn) { submitBtn.textContent = 'Redirecting…'; submitBtn.disabled = true; }

      try {
        const resp = await fetch('https://poc-backend.amdal-dev.workers.dev/api/checkout-intent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, tier: pendingTier, ...utmSnapshot }),
        });
        const data = await resp.json() as { ok?: boolean; checkout_url?: string; error?: string };
        if (data.ok && data.checkout_url) {
          window.location.href = data.checkout_url;
        } else {
          // Fallback to GET checkout if intent fails
          window.location.href = `https://poc-backend.amdal-dev.workers.dev/api/checkout?tier=${encodeURIComponent(pendingTier)}&email=${encodeURIComponent(email)}${utmQuerySuffix}`;
        }
      } catch {
        // Fallback to GET checkout on network error
        window.location.href = `https://poc-backend.amdal-dev.workers.dev/api/checkout?tier=${encodeURIComponent(pendingTier)}&email=${encodeURIComponent(email)}${utmQuerySuffix}`;
      }
    });

    // ── Waitlist form ──
    // Inline-key reveal on success (parity with /get-started/, shipped 2026-05-23).
    // Backend /api/keys/create returns { key, key_prefix } in JSON since the
    // INLINE_KEY_SOURCES gate was removed — display the key on this page so the
    // visitor doesn't have to context-switch to inbox. Email is a backup, not a
    // gate. Source 'web-pricing' is whitelisted in worker.ts VALID_SOURCES so
    // we can measure pricing-page conversions distinct from /get-started/ ones.
    const waitlistForm = document.getElementById('waitlist-form') as HTMLFormElement | null;
    if (waitlistForm) {
      waitlistForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const emailInput = document.getElementById('waitlist-email') as HTMLInputElement;
        const submitBtn = document.getElementById('waitlist-btn') as HTMLButtonElement;
        const successBox = document.getElementById('waitlist-success') as HTMLDivElement;
        const successTitle = document.getElementById('waitlist-success-title') as HTMLParagraphElement;
        const keyDisplay = document.getElementById('waitlist-key-display') as HTMLElement;
        const successNote = document.getElementById('waitlist-success-note') as HTMLParagraphElement;
        const successBackup = document.getElementById('waitlist-success-backup') as HTMLParagraphElement;
        const errorMsg = document.getElementById('waitlist-error') as HTMLParagraphElement;
        const email = emailInput.value.trim();

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          errorMsg.textContent = 'Please enter a valid email address.';
          errorMsg.hidden = false;
          successBox.hidden = true;
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Generating…';
        errorMsg.hidden = true;
        successBox.hidden = true;
        keyDisplay.hidden = true;
        successNote.hidden = true;
        successBackup.hidden = true;

        try {
          // POSTs to /api/keys/create — same endpoint /get-started/ uses.
          // source='web-pricing' so we can split funnel conversion vs the
          // direct /get-started/ landing.
          const res = await fetch('https://poc-backend.amdal-dev.workers.dev/api/keys/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, source: 'web-pricing' }),
          });
          if (res.ok || res.status === 201) {
            const data = await res.json() as { key?: string; key_prefix?: string; message?: string };
            successBox.hidden = false;
            waitlistForm.reset();
            submitBtn.textContent = 'Get free API key';

            if (data?.key) {
              // Inline reveal — primary path. Email is backup.
              successTitle.textContent = '✓ Your free API key';
              keyDisplay.textContent = data.key;
              keyDisplay.hidden = false;
              successNote.hidden = false;
              successBackup.textContent = 'Backup also sent to ' + email + '.';
              successBackup.hidden = false;
            } else {
              // Backup path — backend couldn't return key (RESEND failure?).
              successTitle.textContent = '✓ API key sent to ' + email + ' — check your inbox.';
            }

            // Pre-fill upgrade buttons with the email so Stripe checkout doesn't
            // ask the user to retype it (and so the paid key binds to the same
            // address as the free key).
            const emailEnc = encodeURIComponent(email);
            document.querySelectorAll<HTMLAnchorElement>('.checkout-btn, .upgrade-btn').forEach((btn) => {
              const href = btn.getAttribute('href') ?? '';
              if (href.includes('/api/checkout')) {
                try {
                  const url = new URL(href);
                  url.searchParams.set('email', email);
                  btn.setAttribute('href', url.toString());
                } catch {
                  const sep = href.includes('?') ? '&' : '?';
                  btn.setAttribute('href', href + sep + 'email=' + emailEnc);
                }
              }
            });
          } else {
            const data = await res.json() as any;
            throw new Error(data?.message ?? data?.error ?? `HTTP ${res.status}`);
          }
        } catch (err) {
          errorMsg.textContent = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
          errorMsg.hidden = false;
          submitBtn.textContent = 'Get free API key';
        } finally {
          submitBtn.disabled = false;
        }
      });
    }
  </script>

