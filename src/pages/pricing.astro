    .checkout-modal-close:hover { color: var(--ink); }

    .checkout-modal-eyebrow {
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 0.5rem;
