    .waitlist-text {
      flex: 0 0 auto;
      max-width: 22rem;
    }

    .waitlist-heading {
      font-family: var(--font-display);
      font-size: 1.35rem;
      color: var(--ink);
      margin-bottom: 0.5rem;
    }

    .waitlist-body {
      font-size: 0.9rem;
      color: var(--ink-muted);
      line-height: 1.65;
      margin: 0;
