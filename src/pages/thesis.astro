                  <th style="text-align: center; padding: 0.5rem 0.75rem;">Risk</th>
                  <th style="text-align: right; padding: 0.5rem 0.75rem;">Maintainers</th>
                  <th style="text-align: right; padding: 0.5rem 0.75rem;">Downloads/wk</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid #eee; background: #fff5f5;">
                  <td style="padding: 0.4rem 0.75rem; font-weight: bold;">chalk</td>
