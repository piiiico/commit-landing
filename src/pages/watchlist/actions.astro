    function renderTable() {
      const tbody = document.getElementById('watchlist-tbody')!;

      // Sort: CRITICAL first, then HIGH, WARN, OK; within same risk, by reposNum descending
      const riskOrder: Record<string, number> = { CRITICAL: 0, HIGH: 1, WARN: 2, OK: 3 };
      const sorted = [...ACTIONS].sort((a, b) => {
        const rDiff = riskOrder[a.risk] - riskOrder[b.risk];
        if (rDiff !== 0) return rDiff;
        return b.reposNum - a.reposNum;
      });

      // Stats
      const critActions = sorted.filter(a => a.risk === 'CRITICAL');
      const soloActions = sorted.filter(a => a.ownerType === 'community');
      const writeActions = sorted.filter(a => a.permSensitive);
      const critRepos = critActions.reduce((s, a) => s + a.reposNum, 0);

      function fmtRepos(n: number): string {
        if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
        if (n >= 1_000) return Math.round(n / 1_000) + 'K';
        return String(n);
      }

      document.getElementById('stat-critical')!.textContent = String(critActions.length);
      document.getElementById('stat-repos')!.textContent = fmtRepos(critRepos);
      document.getElementById('stat-solo')!.textContent = String(soloActions.length);
      document.getElementById('stat-write')!.textContent = String(writeActions.length);

      // Render rows
      tbody.innerHTML = sorted.map((action, i) => {
        const badgeClass =
          action.risk === 'CRITICAL' ? 'badge-critical' :
          action.risk === 'HIGH' ? 'badge-high' :
          action.risk === 'WARN' ? 'badge-warn' : 'badge-ok';

        const badgeText =
          action.risk === 'CRITICAL' ? '\u2691 CRITICAL' :
          action.risk === 'HIGH' ? '\u26A0 HIGH' :
          action.risk === 'WARN' ? '\u2193 WARN' : '\u2713 OK';

        const scoreClass =
          action.score < 40 ? 'score-low' :
          action.score < 65 ? 'score-mid' : 'score-ok';

        const ownerClass =
          action.ownerType === 'official' ? 'owner-official' :
          action.ownerType === 'vendor' ? 'owner-vendor' : 'owner-community';

        const rowStyle = action.risk === 'CRITICAL' ? 'background: #fff5f5;' : '';

        const annotationHtml = action.annotation
          ? `<span class="attack-annotation">\u2190 ${action.annotation}</span>`
          : '';

        const permHtml = action.permSensitive
          ? `<span class="perm-sensitive">${action.permissions}</span>`
          : `<span class="perm-text">${action.permissions}</span>`;

        return `<tr style="${rowStyle}">
          <td class="num-muted">${i + 1}</td>
          <td class="pkg-name">
            <a class="pkg-link" href="${action.url}" target="_blank" rel="noopener">${action.name}</a>${annotationHtml}
          </td>
          <td><span class="risk-badge ${badgeClass}">${badgeText}</span></td>
          <td class="score-cell ${scoreClass}">${action.score}/100</td>
          <td class="num-muted">${action.reposUsing}</td>
          <td><span class="owner-badge ${ownerClass}">${action.owner}</span></td>
          <td>${permHtml}</td>
        </tr>`;
      }).join('');
    }

    renderTable();
  </script>
</Layout>
